* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>UPDATE_NOTES
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_TEXT_KEY                     TYPE        TDOBNAME
* | [--->] I_TEXT1                        TYPE        TEXT132
* | [--->] I_TEXT2                        TYPE        TEXT132(optional)
* | [--->] I_TEXT3                        TYPE        TEXT132(optional)
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD update_notes.

  DATA : tb_tline           TYPE STANDARD TABLE OF tline,
         l_tline            TYPE tline,
         l_thead            TYPE thead,
         l_lines            TYPE i,
         l_user_string      TYPE string.


  REFRESH : tb_tline.
  CLEAR   : tb_tline, l_thead.


  CALL FUNCTION 'READ_TEXT'
    EXPORTING
      id                      = 'ZIM1'
      language                = 'E'
      name                    = i_text_key
      object                  = 'ZPOLICE'
    IMPORTING
      header                  = l_thead
    TABLES
      lines                   = tb_tline
    EXCEPTIONS
      id                      = 1
      language                = 2
      name                    = 3
      not_found               = 4
      object                  = 5
      reference_check         = 6
      wrong_access_to_archive = 7
      OTHERS                  = 8.
  IF sy-subrc NE 0.  " No existing notes exist
    CLEAR l_thead.
    l_thead-tdobject = 'ZPOLICE'.
    l_thead-tdname   = i_text_key.
    l_thead-tdid     = 'ZIM1'.
    l_thead-tdform   = 'SYSTEM'.
    l_thead-tdstyle  = 'HR_TEM1'.
    l_thead-tdspras  = 'E'.
  ELSE.
    DESCRIBE TABLE tb_tline LINES l_lines.
    IF l_lines NE 0.
      CLEAR l_tline-tdline.
      APPEND l_tline TO tb_tline.
    ENDIF.
    l_user_string = add_user_text_line( ).
    l_tline-tdline = l_user_string.
    APPEND l_tline TO tb_tline.
  ENDIF.


  CLEAR l_tline.
  l_tline-tdline = i_text1.
  TRANSLATE l_tline-tdline TO UPPER CASE.
  APPEND l_tline TO tb_tline.
  IF i_text2 IS NOT INITIAL.
    l_tline-tdline = i_text2.
    TRANSLATE l_tline-tdline TO UPPER CASE.
    APPEND l_tline TO tb_tline.
  ENDIF.
  IF i_text3 IS NOT INITIAL.
    l_tline-tdline = i_text3.
    TRANSLATE l_tline-tdline TO UPPER CASE.
    APPEND l_tline TO tb_tline.
  ENDIF.

  CALL FUNCTION 'SAVE_TEXT'
    EXPORTING
      header          = l_thead
      savemode_direct = 'X'
    TABLES
      lines           = tb_tline
    EXCEPTIONS
      id              = 1
      language        = 2
      name            = 3
      object          = 4
      OTHERS          = 5.



ENDMETHOD.
ENDCLASS.

class ZCL_OLIMS_CONFIG definition
  public
  final
  create public .

public section.

  constants GC_TOPUP_DAYS_ONDUTY type INT2 value 272. "#EC NOTEXT
  constants GC_IP_DEFAULT_YRS_ONDUTY type INT2 value 7. "#EC NOTEXT
  constants GC_IP_DEFAULT_YRS_OFFDUTY type INT2 value 2. "#EC NOTEXT
  constants GC_IP_BEGIN_DAYS_OFFDUTY type INT2 value 61. "#EC NOTEXT
  constants GC_IP_BEGIN_DAYS_ONDUTY type INT2 value 273. "#EC NOTEXT
  constants GC_TOPUP_WEEKS_ONDUTY type INT2 value 39. "#EC NOTEXT
  constants GC_EPSS_P2_DEFAULT_YRS_OFFDUTY type INT2 value 3. "#EC NOTEXT

  class-methods GET_TOPUP_PERIOD_DATE
