* 11 - Category 99      - General Reminders
*      Business Rule 06 - A 6 Weekly SIMA Review is required
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '99'
           AND business_rule = '06'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF ( l_mast-inc_status = 'O'   OR
         l_mast-inc_status = 'T' ) AND
       l_sima NE l_mast-ima.
      CLEAR l_zim_in_mtg.
      LOOP AT tb_zim_in_mtg INTO l_zim_in_mtg
           WHERE meet_type = 'S'.
        EXIT.
      ENDLOOP.

      IF l_zim_in_mtg-meet_date IS INITIAL.
        IF l_mast-inc_status = 'T'.
          l_days = i_date - l_mast-reopened_date.
          l_date = l_mast-reopened_date + l_zim_rem-rem_days.
        ELSE.
          l_days = i_date - l_mast-date_created.
          l_date = l_mast-date_created + l_zim_rem-rem_days.
        ENDIF.
        IF l_days GE l_zim_rem-rem_days.
          l_days_overdue = l_days - l_zim_rem-rem_days.
          CALL METHOD create_reminder
            EXPORTING
              i_ass_to       = 'S'
              i_ass_emp      = l_sima
              i_note_cat     = l_zim_rem-note_cat
              i_rule         = l_zim_rem-business_rule
              i_pernr        = i_pernr
              i_incident     = i_incident
              i_rem          = l_zim_rem
              i_update       = i_update
              i_days_overdue = l_days_overdue
              i_due_date     = l_date
              i_report       = i_report
            IMPORTING
              e_report       = l_report.
          IF l_report IS NOT INITIAL.
            APPEND l_report TO tb_report.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 12 - Category 99      - General Reminders
*      Business Rule 07 - A 12 Weekly SIMA Review is required
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '99'
           AND business_rule = '07'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF ( l_mast-inc_status = 'O'   OR
         l_mast-inc_status = 'T' ) AND
       l_sima NE l_mast-ima.
      CLEAR : l_zim_in_mtg, l_count, l_meet_date.
      LOOP AT tb_zim_in_mtg INTO l_zim_in_mtg
           WHERE meet_type = 'S'.
        ADD 1 TO l_count.
        l_meet_date = l_zim_in_mtg-meet_date.
      ENDLOOP.
* If the 12 weekly SIMA was held, don't enforce the 6 weekly SIMA
      IF l_meet_date IS NOT INITIAL.
        IF l_mast-inc_status = 'T'.
          l_days2 = l_meet_date - l_mast-reopened_date.
        ELSE.
          l_days2 = l_meet_date - l_mast-date_created.
        ENDIF.
      ENDIF.

      IF l_count LT 2 AND
         l_days2 LT l_zim_rem-rem_days.
        IF l_mast-inc_status = 'T'.
          l_days = i_date - l_mast-reopened_date.
          l_date = l_mast-reopened_date + l_zim_rem-rem_days.
        ELSE.
          l_days = i_date - l_mast-date_created.
          l_date = l_mast-date_created + l_zim_rem-rem_days.
        ENDIF.
        IF l_days GE l_zim_rem-rem_days.
          l_days_overdue = l_days - l_zim_rem-rem_days.
          CALL METHOD create_reminder
            EXPORTING
              i_ass_to       = 'S'
              i_ass_emp      = l_sima
              i_note_cat     = l_zim_rem-note_cat
              i_rule         = l_zim_rem-business_rule
              i_pernr        = i_pernr
              i_incident     = i_incident
              i_rem          = l_zim_rem
              i_update       = i_update
              i_days_overdue = l_days_overdue
              i_due_date     = l_date
              i_report       = i_report
            IMPORTING
              e_report       = l_report.
          IF l_report IS NOT INITIAL.
            APPEND l_report TO tb_report.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 13 - Category 99      - General Reminders
*      Business Rule 08 - A 6 Monthly SIMA Review is required
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '99'
           AND business_rule = '08'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF ( l_mast-inc_status = 'O'   OR
         l_mast-inc_status = 'T' ) AND
       l_sima NE l_mast-ima.
      CLEAR : l_zim_in_mtg, l_count, l_meet_date.
      LOOP AT tb_zim_in_mtg INTO l_zim_in_mtg
           WHERE meet_type = 'S'.
        ADD 1 TO l_count.
        IF l_count = 1.
          l_meet_date = l_zim_in_mtg-meet_date.
        ENDIF.
      ENDLOOP.

* If the 6 monthly SIMA was held, don't enforce the 6 weekly SIMA
* or the 12 weekly SIMA
      IF l_meet_date IS NOT INITIAL.
        IF l_mast-inc_status = 'T'.
          l_days2 = l_meet_date - l_mast-reopened_date.
        ELSE.
          l_days2 = l_meet_date - l_mast-date_created.
        ENDIF.
      ENDIF.

      IF l_count LT 3 AND
         l_days2 LT l_zim_rem-rem_days.
        IF l_mast-inc_status = 'T'.
          l_days = i_date - l_mast-reopened_date.
          l_date = l_mast-reopened_date + l_zim_rem-rem_days.
        ELSE.
          l_days = i_date - l_mast-date_created.
          l_date = l_mast-date_created + l_zim_rem-rem_days.
        ENDIF.
        IF l_days GE l_zim_rem-rem_days.
          l_days_overdue = l_days - l_zim_rem-rem_days.
          CALL METHOD create_reminder
            EXPORTING
              i_ass_to       = 'S'
              i_ass_emp      = l_sima
              i_note_cat     = l_zim_rem-note_cat
              i_rule         = l_zim_rem-business_rule
              i_pernr        = i_pernr
              i_incident     = i_incident
              i_rem          = l_zim_rem
              i_update       = i_update
              i_days_overdue = l_days_overdue
              i_due_date     = l_date
              i_report       = i_report
            IMPORTING
              e_report       = l_report.
          IF l_report IS NOT INITIAL.
            APPEND l_report TO tb_report.
          ENDIF.
        ENDIF.
      ELSE.
        l_days = i_date - l_meet_date.
        l_date = l_meet_date + l_zim_rem-rem_days.
        IF l_days GE l_zim_rem-rem_days.
          l_days_overdue = l_days - l_zim_rem-rem_days.
          CALL METHOD create_reminder
            EXPORTING
              i_ass_to       = 'S'
              i_ass_emp      = l_sima
              i_note_cat     = l_zim_rem-note_cat
              i_rule         = l_zim_rem-business_rule
              i_pernr        = i_pernr
              i_incident     = i_incident
              i_rem          = l_zim_rem
              i_update       = i_update
              i_days_overdue = l_days_overdue
              i_due_date     = l_date
              i_report       = i_report
            IMPORTING
              e_report       = l_report.
          IF l_report IS NOT INITIAL.
            APPEND l_report TO tb_report.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 14 - Category 17      - R@WP
*      Business Rule 01 - PR@WP created within 1 month of incident
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '17'
           AND business_rule = '01'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF ( l_mast-inc_status = 'O'   OR
         l_mast-inc_status = 'T' ).
      IF l_zim_in_cert-status = 'U' OR
         l_zim_in_cert-status = 'N'.
        IF l_mast-inc_status = 'T'.
          l_days = i_date - l_mast-reopened_date.
        ELSE.
          l_days = i_date - l_mast-date_created.
        ENDIF.
        IF l_days GE l_zim_rem-rem_days.
          SELECT SINGLE * FROM zim_rtwp
                 INTO l_zim_rtwp
                 WHERE pernr    = i_pernr
                   AND incident = i_incident.
          IF sy-subrc NE 0.
* The employee may have multiple cases open and the RTWP could be linked
* to a different incident
            SELECT * FROM zim_rtwp
                   INTO TABLE tb_zim_rtwp
                   WHERE pernr = i_pernr.
            SORT tb_zim_rtwp BY goal_date DESCENDING.
            CLEAR l_zim_rtwp.
            LOOP AT tb_zim_rtwp INTO l_zim_rtwp.
              EXIT.
            ENDLOOP.
            IF l_zim_rtwp-goal_date IS NOT INITIAL.
              l_days2 = i_date - l_zim_rtwp-goal_date.
            ENDIF.
            IF l_days2 GE l_zim_rem-rem_days.
              l_days_overdue = l_days - l_zim_rem-rem_days.
              l_date = l_zim_rtwp-goal_date + l_zim_rem-rem_days.
              CALL METHOD create_reminder
                EXPORTING
                  i_ass_to       = 'I'
                  i_ass_emp      = l_mast-ima
                  i_note_cat     = l_zim_rem-note_cat
                  i_rule         = l_zim_rem-business_rule
                  i_pernr        = i_pernr
                  i_incident     = i_incident
                  i_rem          = l_zim_rem
                  i_update       = i_update
                  i_days_overdue = l_days_overdue
                  i_due_date     = l_date
                  i_report       = i_report
                IMPORTING
                  e_report       = l_report.
              IF l_report IS NOT INITIAL.
                APPEND l_report TO tb_report.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

*      Category 99      - General Reminder
*      Business Rule 22 - Unfit for 4 weeks – IMA to arrange a
*                         case conference
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '99'
           AND business_rule = '22'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL AND
     i_report IS INITIAL.                 " Not required for the report

    IF ( l_mast-inc_status = 'O' OR
         l_mast-inc_status = 'T' ) AND         "Reopened
       ( l_zim_in_cert-status = 'U' OR
         l_zim_in_cert-status = 'N' ).
      IF l_mast-inc_status = 'T'.
        l_days = i_date - l_mast-reopened_date.
        l_doc_unique = 'T'.
      ELSE.
        l_days = i_date - l_mast-date_created.
        l_doc_unique = 'O'.
      ENDIF.

      IF l_days GE l_zim_rem-rem_days.
* Only create a reminder if one has not already been created
        SELECT SINGLE * FROM zim_in_rem
               INTO l_zim_in_rem
               WHERE pernr         = l_mast-pernr
                 AND incident      = l_mast-incident
                 AND ass_to        = 'I'
                 AND ass_emp       = l_mast-ima
                 AND doc_unique    = l_doc_unique
                 AND note_cat      = l_zim_rem-note_cat
                 AND business_rule = l_zim_rem-business_rule
                 AND message_type  = 'B'.
        IF sy-subrc NE 0.
          CALL METHOD create_reminder
            EXPORTING
              i_ass_to     = 'I'
              i_ass_emp    = l_mast-ima
              i_note_cat   = l_zim_rem-note_cat
              i_rule       = l_zim_rem-business_rule
              i_pernr      = i_pernr
              i_incident   = i_incident
              i_rem        = l_zim_rem
              i_update     = i_update
              i_doc_unique = l_doc_unique
              i_report     = i_report
            IMPORTING
              e_report     = l_report.
          IF l_report IS NOT INITIAL.
            APPEND l_report TO tb_report.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

*      Category 99
*      Business Rule 23 - Unfit for X weeks – SIMA review required


* 15 - Category 10      - External Provider Service
*      Business Rule 01 - Unfit for 8 weeks external provider service
*                         required


* 16 - Category 17      - R@WP
*      Business Rule 02 - If SD, an R@WP must be in place the day after
*                         the medical certificate
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '17'
           AND business_rule = '02'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_mast-inc_status = 'O' OR
       l_mast-inc_status = 'T'.
      IF l_zim_in_cert-status = 'SD' OR
         l_zim_in_cert-status = 'C'.
        SELECT SINGLE * FROM zim_rtwp
               INTO l_zim_rtwp
               WHERE pernr     =  i_pernr
                 AND date_to   GE l_zim_in_cert-date_to.
        IF sy-subrc NE 0.
          SELECT SINGLE * FROM zim_rtwp_grade
                 INTO l_zim_rtwp_grade
                 WHERE pernr     =  i_pernr
                   AND date_to   GE l_zim_in_cert-date_to.
          IF sy-subrc NE 0.
* Check to determine if they have a second MC which is Unfit
            SELECT SINGLE * FROM zim_in_cert
                   INTO l_cert
                   WHERE pernr     =  i_pernr
                     AND date_from LE i_date
                     AND date_to   GE i_date
                     AND status    =  'U'.
            IF sy-subrc NE 0.
* Check to determine if they have a second CC which is No Capacity
              SELECT SINGLE * FROM zim_in_cap
                     INTO l_cap
                     WHERE pernr     =  i_pernr
                       AND date_from LE i_date
                       AND date_to   GE i_date
                       AND status    =  'N'.
              IF sy-subrc NE 0.
                l_days_overdue = i_date - l_zim_in_cert-date_from.
                l_date = l_zim_in_cert-date_from + 1.
                CALL METHOD create_reminder
                  EXPORTING
                    i_ass_to       = 'I'
                    i_ass_emp      = l_mast-ima
                    i_note_cat     = l_zim_rem-note_cat
                    i_rule         = l_zim_rem-business_rule
                    i_pernr        = i_pernr
                    i_incident     = i_incident
                    i_rem          = l_zim_rem
                    i_update       = i_update
                    i_days_overdue = l_days_overdue
                    i_due_date     = l_date
                    i_report       = i_report
                  IMPORTING
                    e_report       = l_report.
                IF l_report IS NOT INITIAL.
                  APPEND l_report TO tb_report.
                ENDIF.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 17 - Category 18      - Certificate of Capacity
*      Business Rule 03 - If a certificate has the employee as
*                         Fit for Pre Injury Duties, the case should be
*                         closed within 1 month
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '18'
           AND business_rule = '03'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_mast-inc_status = 'O' OR
       l_mast-inc_status = 'T'.
      IF l_zim_in_cert-status = 'P'.
        l_days = i_date - l_zim_in_cert-date_from.
        IF l_days GE l_zim_rem-rem_days.
          l_days_overdue = l_days - l_zim_rem-rem_days.
          l_date = l_zim_in_cert-date_from + l_zim_rem-rem_days.
          CALL METHOD create_reminder
            EXPORTING
              i_ass_to       = 'I'
              i_ass_emp      = l_mast-ima
              i_note_cat     = l_zim_rem-note_cat
              i_rule         = l_zim_rem-business_rule
              i_pernr        = i_pernr
              i_incident     = i_incident
              i_rem          = l_zim_rem
              i_update       = i_update
              i_days_overdue = l_days_overdue
              i_due_date     = l_date
              i_report       = i_report
            IMPORTING
              e_report       = l_report.
          IF l_report IS NOT INITIAL.
            APPEND l_report TO tb_report.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 18 - Category 11      - ROSA Referral
*      Business Rule 01 - The employee is Fit for PID, determine if a
*                         ROSA or a PMO is required
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '11'
           AND business_rule = '01'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL AND
     i_report IS INITIAL.

    IF l_mast-inc_status = 'O' OR
       l_mast-inc_status = 'T' AND
       l_mast-hod IS INITIAL.
      IF l_zim_in_cert-status = 'P'.
        IF l_pa0001-persk LE 'XF'.
* Only create a reminder if one has not already been created
          SELECT SINGLE * FROM zim_in_rem
                 INTO l_zim_in_rem
                 WHERE pernr         = i_pernr
                   AND incident      = i_incident
                   AND ass_to        = 'I'
                   AND ass_emp       = l_mast-ima
                   AND doc_unique    = ' '
                   AND note_cat      = l_zim_rem-note_cat
                   AND business_rule = l_zim_rem-business_rule
                   AND message_type  = 'B'.
          IF sy-subrc NE 0.
            CALL METHOD create_reminder
              EXPORTING
                i_ass_to   = 'I'
                i_ass_emp  = l_mast-ima
                i_note_cat = l_zim_rem-note_cat
                i_rule     = l_zim_rem-business_rule
                i_pernr    = i_pernr
                i_incident = i_incident
                i_rem      = l_zim_rem
                i_update   = i_update
              IMPORTING
                e_report   = l_report.
            IF l_report IS NOT INITIAL.
              APPEND l_report TO tb_report.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 19 - Category 16      - Medical Certificate
*      Business Rule 04 - If the final medical certificate recommends
*                         Restricted, the case should be referred
*                         to the PRD Unit
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '16'
           AND business_rule = '04'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_mast-inc_status = 'O' OR
       l_mast-inc_status = 'T'.
      IF l_zim_in_cert-category = 'F' AND
         l_zim_in_cert-status   = 'R'.
        l_days = i_date - l_zim_in_cert-mc_date.
        l_date = l_zim_in_cert-mc_date + 1.
        IF l_days GE 1.
          CALL METHOD create_reminder
            EXPORTING
              i_ass_to   = 'I'
              i_ass_emp  = l_mast-ima
              i_note_cat = l_zim_rem-note_cat
              i_rule     = l_zim_rem-business_rule
              i_pernr    = i_pernr
              i_incident = i_incident
              i_rem      = l_zim_rem
              i_update   = i_update
              i_due_date = l_date
              i_report   = i_report
            IMPORTING
              e_report   = l_report.
          IF l_report IS NOT INITIAL.
            APPEND l_report TO tb_report.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

** 20 - Category 10      - External Provider Service
**     Business Rule 02 - External provider service request has not been
**                         confirmed 3 days after the request
*

* 21 - Category 11      - ROSA
*      Business Rule 02 - ROSA Review date has been reached
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '11'
           AND business_rule = '02'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL AND
     i_report IS INITIAL.

    IF l_mast-inc_status = 'O' OR
       l_mast-inc_status = 'T'.
      IF l_mast-rosa_review GE i_date.
        l_days_overdue = l_mast-rosa_review - i_date.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to       = 'I'
            i_ass_emp      = l_mast-ima
            i_note_cat     = l_zim_rem-note_cat
            i_rule         = l_zim_rem-business_rule
            i_pernr        = i_pernr
            i_incident     = i_incident
            i_rem          = l_zim_rem
            i_update       = i_update
            i_days_overdue = l_days_overdue
            i_due_date     = l_mast-rosa_review
            i_report       = i_report
          IMPORTING
            e_report       = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 22 - Category 12      - PMO
*      Business Rule 01 - PMO Review date has been reached
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '12'
           AND business_rule = '01'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL AND
     i_report IS INITIAL.

    IF l_mast-inc_status = 'O' OR
       l_mast-inc_status = 'T'.
      IF l_mast-pmo_review GE i_date.
        l_days_overdue = l_mast-pmo_review - i_date.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to       = 'I'
            i_ass_emp      = l_mast-ima
            i_note_cat     = l_zim_rem-note_cat
            i_rule         = l_zim_rem-business_rule
            i_pernr        = i_pernr
            i_incident     = i_incident
            i_rem          = l_zim_rem
            i_update       = i_update
            i_days_overdue = l_days_overdue
            i_due_date     = l_mast-pmo_review
            i_report       = i_report
          IMPORTING
            e_report       = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

** 23 - Category 18      - Certificate of Capacity
**      Business Rule 12 - Certificate of Capacity changed from PID to
**                         Has Capacity - Graded R@WP required

* No longer required as it is the same as 17/02
*     If SD, an R@WP must be in place the day after
*     the medical certificate



ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>GENERATE_REMINDERS_IP
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_PERNR                        TYPE        PERSNO
* | [--->] I_INCIDENT                     TYPE        ZHR_INC_IDENTNR
* | [--->] I_UPDATE                       TYPE        CHAR1(optional)
* | [--->] I_DATE                         TYPE        DATUM
* | [--->] I_REPORT                       TYPE        CHAR1(optional)
* | [<---] TB_REPORT                      TYPE        ZIM_REM_REPORT_T
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD generate_reminders_ip.

  DATA : l_mast             TYPE zim_in_mast,
         l_incident         TYPE zim_incident,
         l_pa0001           TYPE pa0001,
         tb_zim_in_cert     TYPE STANDARD TABLE OF zim_in_cert,
         tb_zim_in_cap      TYPE STANDARD TABLE OF zim_in_cap,
         tb_zim_in_claim    TYPE STANDARD TABLE OF zim_in_claim,
         tb_zim_in_cm       TYPE STANDARD TABLE OF zim_in_cm,
         tb_zim_in_ip       TYPE STANDARD TABLE OF zim_in_ip,
         l_report           TYPE zim_rem_report,
         l_zim_in_cert      TYPE zim_in_cert,
         l_cert             TYPE zim_in_cert,
         l_zim_in_cap       TYPE zim_in_cap,
         l_cap              TYPE zim_in_cap,
         l_zim_in_claim     TYPE zim_in_claim,
         l_zim_in_cm        TYPE zim_in_cm,
         l_zim_in_ip        TYPE zim_in_ip,
         l_zim_in_rem       TYPE zim_in_rem,
         l_zim_in_doc_in    TYPE zim_in_doc_in,
         l_zim_rem          TYPE zim_rem,
         l_days             TYPE i,
         l_days2            TYPE i,
         l_date             TYPE d,
         l_subrc            TYPE sy-subrc,
         l_days_overdue     TYPE int4,
         l_lines            TYPE i,
         l_count            TYPE i,
         l_doc_unique       TYPE zim_doc_unique,
         l_send(1)          TYPE c,
         l_admin(1)         TYPE c.



  REFRESH tb_report.

  SELECT SINGLE * FROM zim_in_mast
         INTO l_mast
         WHERE pernr    = i_pernr
           AND incident = i_incident.
  IF sy-subrc NE 0.
    RETURN.
  ENDIF.

* No reminders for One-off incidents
  IF l_mast-inc_type = 'O'.
    RETURN.
  ENDIF.


* Retrieve lookup details

  SELECT SINGLE * FROM pa0001
         INTO l_pa0001
         WHERE pernr = i_pernr
           AND begda LE sy-datum
           AND endda GE sy-datum.
  IF sy-subrc NE 0.
    CLEAR l_pa0001.
  ENDIF.


  SELECT SINGLE * FROM zim_incident
         INTO l_incident
         WHERE pernr    = i_pernr
           AND incident = i_incident.
  IF sy-subrc NE 0.
    RETURN.
  ENDIF.

  SELECT SINGLE * FROM zim_in_cm
         INTO l_zim_in_cm
         WHERE pernr    = i_pernr
           AND incident = i_incident.
  IF sy-subrc NE 0.
    RETURN.
  ENDIF.

  SELECT * FROM zim_in_claim
         INTO TABLE tb_zim_in_claim
         WHERE pernr    = i_pernr
           AND incident = i_incident.
  SORT tb_zim_in_claim BY claim_type
                          begda      DESCENDING.

  SELECT * FROM zim_in_ip
         INTO TABLE tb_zim_in_ip
         WHERE pernr    = i_pernr
           AND incident = i_incident.
  SORT tb_zim_in_ip BY record_type
                       begda      DESCENDING.

  SELECT * FROM zim_in_cert
         INTO TABLE tb_zim_in_cert
         WHERE pernr    = i_pernr
           AND incident = i_incident
           AND inactive = ' '.
  SELECT * FROM zim_in_cap
         APPENDING CORRESPONDING FIELDS OF TABLE tb_zim_in_cert
         WHERE pernr    = i_pernr
           AND incident = i_incident
           AND inactive = ' '.
  SORT tb_zim_in_cert BY mc_date   DESCENDING
                         date_from DESCENDING
                         date_to   DESCENDING.


  IF ( l_pa0001-persk GE 'XG' AND
       l_pa0001-persk LE 'XT' ) OR
       l_pa0001-persk  = 'XY'   OR " CR3185 PMP Project
       l_pa0001-persk  = 'XX' .
    l_admin = 'X'.
  ELSE.
    CLEAR l_admin.
  ENDIF.


* 01 - Category 85      - Case Management
*      Business Rule 03 - Off Duty Claim, 50 days after
*                         Date of Disablement
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '85'
           AND business_rule = '03'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_admin IS INITIAL AND
       l_zim_in_cm-disablement_date IS NOT INITIAL.
      IF l_zim_in_cm-ip_status = 'O' AND
         l_zim_in_cm-duty_det  = 'F'.
        l_days = i_date - l_zim_in_cm-disablement_date.
        IF l_days GE l_zim_rem-rem_days.
* Only create a reminder if one has not already been created
          SELECT SINGLE * FROM zim_in_rem
                 INTO l_zim_in_rem
                 WHERE pernr         = i_pernr
                   AND incident      = i_incident
                   AND ass_to        = 'W'
                   AND ass_emp       = l_zim_in_cm-ip_advisor
                   AND doc_unique    = ' '
                   AND note_cat      = l_zim_rem-note_cat
                   AND business_rule = l_zim_rem-business_rule
                   AND message_type  = 'B'.
          IF sy-subrc NE 0.
            CALL METHOD create_reminder
              EXPORTING
                i_ass_to   = 'W'
                i_ass_emp  = l_zim_in_cm-ip_advisor
                i_note_cat = l_zim_rem-note_cat
                i_rule     = l_zim_rem-business_rule
                i_pernr    = i_pernr
                i_incident = i_incident
                i_rem      = l_zim_rem
                i_update   = i_update
              IMPORTING
                e_report   = l_report.
            IF l_report IS NOT INITIAL.
              APPEND l_report TO tb_report.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 02 - Category 85      - Case Management
*      Business Rule 05 - 30 Days prior to IP End Date
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '85'
           AND business_rule = '05'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_admin IS INITIAL AND
       l_zim_in_cm-ip_end_date IS NOT INITIAL.
      IF l_zim_in_cm-wc_status = 'O'.
        l_days = l_zim_in_cm-ip_end_date - i_date.
        IF l_days LE l_zim_rem-rem_days.
* Only create a reminder if one has not already been created
          SELECT SINGLE * FROM zim_in_rem
                 INTO l_zim_in_rem
                 WHERE pernr         = i_pernr
                   AND incident      = i_incident
                   AND ass_to        = 'W'
                   AND ass_emp       = l_zim_in_cm-ip_advisor
                   AND doc_unique    = ' '
                   AND note_cat      = l_zim_rem-note_cat
                   AND business_rule = l_zim_rem-business_rule
                   AND message_type  = 'B'.
          IF sy-subrc NE 0.
            CALL METHOD create_reminder
              EXPORTING
                i_ass_to   = 'W'
                i_ass_emp  = l_zim_in_cm-ip_advisor
                i_note_cat = l_zim_rem-note_cat
                i_rule     = l_zim_rem-business_rule
                i_pernr    = i_pernr
                i_incident = i_incident
                i_rem      = l_zim_rem
                i_update   = i_update
              IMPORTING
                e_report   = l_report.
            IF l_report IS NOT INITIAL.
              APPEND l_report TO tb_report.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 03 - Category 85      - Case Management
*      Business Rule 08 - First claim review after 6 weeks
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '85'
           AND business_rule = '08'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_zim_in_cm-ip_status = 'O'.
      IF l_zim_in_cm-disablement_date IS NOT INITIAL.
        l_days = i_date - l_zim_in_cm-disablement_date.
      ELSE.
        l_days = i_date - l_incident-datereported.
      ENDIF.
      IF l_days GE l_zim_rem-rem_days        AND
         l_zim_in_cm-claim_review IS INITIAL.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to   = 'W'
            i_ass_emp  = l_zim_in_cm-ip_advisor
            i_note_cat = l_zim_rem-note_cat
            i_rule     = l_zim_rem-business_rule
            i_pernr    = i_pernr
            i_incident = i_incident
            i_rem      = l_zim_rem
            i_update   = i_update
          IMPORTING
            e_report   = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 04 - Category 85      - Case Management
*      Business Rule 11 - Second claim review after 26 weeks
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '85'
           AND business_rule = '11'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_zim_in_cm-ip_status = 'O'.
      IF l_zim_in_cm-disablement_date IS NOT INITIAL.
        l_days = i_date - l_zim_in_cm-disablement_date.
      ELSE.
        l_days = i_date - l_incident-datereported.
      ENDIF.
      IF l_days GE l_zim_rem-rem_days        AND
         l_zim_in_cm-claim_review LT '4'.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to   = 'W'
            i_ass_emp  = l_zim_in_cm-ip_advisor
            i_note_cat = l_zim_rem-note_cat
            i_rule     = l_zim_rem-business_rule
            i_pernr    = i_pernr
            i_incident = i_incident
            i_rem      = l_zim_rem
            i_update   = i_update
          IMPORTING
            e_report   = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 05 - Category 85      - Case Management
*      Business Rule 12 - Third claim review after 52 weeks
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '85'
           AND business_rule = '12'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_zim_in_cm-ip_status = 'O'.
      IF l_zim_in_cm-disablement_date IS NOT INITIAL.
        l_days = i_date - l_zim_in_cm-disablement_date.
      ELSE.
        l_days = i_date - l_incident-datereported.
      ENDIF.
      IF l_days GE l_zim_rem-rem_days        AND
         l_zim_in_cm-claim_review LT '5'.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to   = 'W'
            i_ass_emp  = l_zim_in_cm-ip_advisor
            i_note_cat = l_zim_rem-note_cat
            i_rule     = l_zim_rem-business_rule
            i_pernr    = i_pernr
            i_incident = i_incident
            i_rem      = l_zim_rem
            i_update   = i_update
          IMPORTING
            e_report   = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 06 - Category 85      - Case Management
*      Business Rule 14 - Employers Statement not returned by PAC/PD
*                         within 7 days
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '85'
           AND business_rule = '14'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_admin IS INITIAL AND
       l_zim_in_cm-emp_sent_date IS NOT INITIAL.
      l_date = l_zim_in_cm-emp_sent_date + l_zim_rem-rem_days.
      IF l_zim_in_cm-ip_status = 'O' AND
         l_date LE i_date.
        SELECT SINGLE * FROM zim_in_doc_in
               INTO l_zim_in_doc_in
               WHERE pernr          = i_pernr
                 AND incident       = i_incident
                 AND ( ltr_category = 'DG'
                   OR  ltr_category = 'DN' )
                 AND date_processed GE l_zim_in_cm-emp_sent_date.
        IF sy-subrc NE 0.
          CALL METHOD create_reminder
            EXPORTING
              i_ass_to   = 'W'
              i_ass_emp  = l_zim_in_cm-ip_advisor
              i_note_cat = l_zim_rem-note_cat
              i_rule     = l_zim_rem-business_rule
              i_pernr    = i_pernr
              i_incident = i_incident
              i_rem      = l_zim_rem
              i_update   = i_update
            IMPORTING
              e_report   = l_report.
          IF l_report IS NOT INITIAL.
            APPEND l_report TO tb_report.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 07 - Category 85      - Case Management
*      Business Rule 15 - Claim has not been submitted
*                         with criteria after 250 days
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '85'
           AND business_rule = '15'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    CLEAR l_zim_in_claim.
    LOOP AT tb_zim_in_claim INTO l_zim_in_claim
            WHERE claim_type = 'I'.
      EXIT.
    ENDLOOP.

    CLEAR : l_zim_in_ip, l_date, l_days.
    LOOP AT tb_zim_in_ip INTO l_zim_in_ip
            WHERE top_up = 'X'.
      l_date = l_zim_in_ip-endda.
      l_days = l_zim_in_ip-endda - i_date.
      EXIT.
    ENDLOOP.

* The IP Claim Status was initially using the IT9076 claim status
* where Pending is '1'.
* A new domain has now been created for the IP claim status
* where Pending is 'P' and Claim Pack Sent is '1'.
    IF ( l_zim_in_claim-stat    = '1' OR     " Pending or Claim Pack Sent
         l_zim_in_claim-stat    = 'P' ) AND  " Pending
       l_date IS NOT INITIAL.
      IF l_days LE l_zim_rem-rem_days.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to   = 'W'
            i_ass_emp  = l_zim_in_cm-ip_advisor
            i_note_cat = l_zim_rem-note_cat
            i_rule     = l_zim_rem-business_rule
            i_pernr    = i_pernr
            i_incident = i_incident
            i_rem      = l_zim_rem
            i_update   = i_update
          IMPORTING
            e_report   = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 08 - Category 85      - Case Management
*      Business Rule 16 - Follow up lodgement with Criteria
*
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '85'
           AND business_rule = '16'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    CLEAR l_zim_in_claim.
    LOOP AT tb_zim_in_claim INTO l_zim_in_claim
            WHERE claim_type = 'I'.
      EXIT.
    ENDLOOP.

    IF   l_zim_in_claim-stat    = '2'.     " Lodged with FSS
      l_days = i_date - l_zim_in_claim-begda.
      IF l_days GE l_zim_rem-rem_days.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to   = 'W'
            i_ass_emp  = l_zim_in_cm-ip_advisor
            i_note_cat = l_zim_rem-note_cat
            i_rule     = l_zim_rem-business_rule
            i_pernr    = i_pernr
            i_incident = i_incident
            i_rem      = l_zim_rem
            i_update   = i_update
          IMPORTING
            e_report   = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 09 - Category 85      - Case Management
*      Business Rule 17 - Attending Doctors certificate has
*                         not been received
*      NOTE - this will result in an email being sent to the employee
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '85'
           AND business_rule = '17'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    CLEAR l_zim_in_claim.
    LOOP AT tb_zim_in_claim INTO l_zim_in_claim
            WHERE claim_type = 'I'.
      EXIT.
    ENDLOOP.

    IF   l_zim_in_claim-stat    = '3'.     " Lodged with FSS no ADS
* A reminder should be created every 30 days
      SELECT SINGLE * FROM zim_in_rem
             INTO l_zim_in_rem
             WHERE pernr         = i_pernr
               AND incident      = i_incident
               AND ass_to        = 'E'
               AND ass_emp       = '00000000'
               AND doc_unique    = ' '
               AND note_cat      = l_zim_rem-note_cat
               AND business_rule = l_zim_rem-business_rule
               AND message_type  = 'B'.
      IF sy-subrc = 0.
        l_days = i_date - l_zim_in_rem-created_date.
      ELSE.
        l_days = 999.
      ENDIF.
      IF l_days GE l_zim_rem-rem_days.

        CALL METHOD create_reminder
          EXPORTING
            i_ass_to   = 'E'
            i_ass_emp  = '00000000'
            i_note_cat = l_zim_rem-note_cat
            i_rule     = l_zim_rem-business_rule
            i_pernr    = i_pernr
            i_incident = i_incident
            i_rem      = l_zim_rem
            i_update   = i_update
          IMPORTING
            e_report   = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.


ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>GET_DOMAIN_DESC
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_DOMAIN                       TYPE        DOMNAME
* | [--->] I_VALUE                        TYPE        DOMVALUE_L
* | [<-()] E_DESC                         TYPE        DDTEXT
* +--------------------------------------------------------------------------------------</SIGNATURE>
method GET_DOMAIN_DESC.

    data : w_dd07v      type dd07v,
           w_rc         type sy-subrc.

    clear e_desc.

    call function 'DD_DOMVALUE_TEXT_GET'
      exporting
        domname  = i_domain
        value    = i_value
        langu    = 'E'
      importing
        dd07v_wa = w_dd07v
        rc       = w_rc
      exceptions
        others   = 1.
    if  w_rc ne 0.
      clear w_dd07v.
    endif.

    e_desc = w_dd07v-ddtext.


endmethod.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>GET_EMP_EMAIL
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_PERNR                        TYPE        PERSNO
* | [<---] E_EMAIL                        TYPE        COMM_ID_LONG
* | [<---] E_NAME                         TYPE        ZGEN_USER_NAME
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD get_emp_email.

  DATA : l_pa0001            TYPE pa0001,
         l_pa0105            TYPE pa0105.

  CLEAR : e_name, e_email.

  SELECT SINGLE * FROM pa0001
         INTO l_pa0001
         WHERE pernr = i_pernr
           AND begda LE sy-datum
           AND endda GE sy-datum.
  IF sy-subrc = 0.
    e_name = l_pa0001-ename.
  ENDIF.

  SELECT SINGLE * FROM pa0105
         INTO l_pa0105
         WHERE pernr = i_pernr
           AND subty = 'MAIL'
           AND begda LE sy-datum
           AND endda GE sy-datum.
  IF sy-subrc = 0.
    e_email = l_pa0105-usrid_long.
  ELSE.
    SELECT SINGLE * FROM pa0105
           INTO l_pa0105
           WHERE pernr = i_pernr
             AND subty = 'MEMO'
             AND begda LE sy-datum
             AND endda GE sy-datum.
    IF sy-subrc = 0.
      e_email = l_pa0105-usrid.
    ENDIF.
  ENDIF.


ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>GET_EMP_HOME_EMAIL
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_PERNR                        TYPE        PERSNO
* | [--->] I_INCIDENT                     TYPE        ZHR_INC_IDENTNR(optional)
* | [<---] E_EMAIL                        TYPE        COMM_ID_LONG
* | [<---] E_NAME                         TYPE        ZGEN_USER_NAME
* | [<---] E_SMS                          TYPE        COMNR
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD get_emp_home_email.

  DATA : l_pa0001            TYPE pa0001,
         l_pa0105            TYPE pa0105.

  CLEAR : e_name, e_email, e_sms.

  SELECT SINGLE * FROM pa0001
         INTO l_pa0001
         WHERE pernr = i_pernr
           AND begda LE sy-datum
           AND endda GE sy-datum.
  IF sy-subrc = 0.
    e_name = l_pa0001-ename.
  ENDIF.

* As agreed by the business, the program will first select from
* the details updated by the IMA and second from the details
* entered on the P902.

  DATA: l_num(2)        TYPE n,
        l_zim_address   TYPE zim_address,
        l_zim_incident  TYPE zim_incident.


  SELECT SINGLE * FROM zim_address
         INTO l_zim_address
         WHERE pernr = i_pernr.
  IF sy-subrc = 0.
    e_email = l_zim_address-email.
    e_sms   = l_zim_address-mobile.
  ENDIF.

  IF e_email IS INITIAL OR
     e_sms   IS INITIAL.
    SELECT SINGLE * FROM zim_incident
           INTO l_zim_incident
           WHERE pernr    = i_pernr
             and incident = i_incident.
    IF sy-subrc NE 0.
      CLEAR l_zim_incident.
    ENDIF.
  ENDIF.

  IF e_email IS INITIAL.
    IF l_zim_incident-oth_home_email IS NOT INITIAL.
      e_email = l_zim_incident-oth_home_email.
    ENDIF.
*    SELECT SINGLE * FROM pa0105
*           WHERE pernr = p_pernr
*             AND subty = 'MAIL'
*             AND begda LE sy-datum
*             AND endda GE sy-datum.
*    IF sy-subrc = 0.
*      p_email = pa0105-USRID_LONG.
*    ENDIF.
  ENDIF.

  IF e_sms IS INITIAL.
    IF l_zim_incident-oth_home_mobile IS NOT INITIAL.
      e_sms = l_zim_incident-oth_home_mobile.
    ENDIF.
*    SELECT SINGLE * FROM pa0006
*           WHERE pernr = p_pernr
*             AND subty = '1   '
*             AND begda LE sy-datum
*             AND endda GE sy-datum.
*    IF sy-subrc = 0.
*      l_num = 1.
*      DO 6 TIMES.
*        CONCATENATE 'PA0006-COM' l_num INTO l_field.
*        ASSIGN (l_field) TO <fs>.
*        IF <fs> = 'MOBL'.
*          CONCATENATE 'PA0006-NUM' l_num INTO l_field.
*          ASSIGN (l_field) TO <fs>.
*          p_sms = <fs>.
*        ENDIF.
*        l_num = l_num + 1.
*      ENDDO.
*    ENDIF.

  ENDIF.



ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>GET_ORG_FROM_POSITION
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_PLANS                        TYPE        PLANS
* | [--->] I_DATE                         TYPE        DATUM(optional)
* | [<-()] R_ORGEH                        TYPE        ORGEH
* +--------------------------------------------------------------------------------------</SIGNATURE>
method GET_ORG_FROM_POSITION.

data : l_hrp1001           type hrp1001,
       l_date              type d.

clear r_orgeh.

  if i_date is initial.
    l_date = sy-datum.
  else.
    l_date = i_date.
  endif.

  select single * from hrp1001
         into l_hrp1001
         where otype = 'S'
           and objid = i_plans
           and plvar = '01'
           and rsign = 'A'
           and relat = '003'
           and istat = '1'
           and sclas = 'O'
           and begda le l_date
           and endda ge l_date.
  if sy-subrc = 0.
    r_orgeh = l_hrp1001-sobid(8).
  endif.


endmethod.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>LOCK_DEPEND
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_PERNR                        TYPE        PERSNO
* | [<---] E_LOCKED                       TYPE        CHAR1
* | [<---] E_NAME                         TYPE        STEXT
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD lock_depend.


  DATA: l_subrc     LIKE sy-subrc,
        l_tabix     LIKE sy-tabix,
        l_key(11)   TYPE c,
        l_uname(12) TYPE c,
        tb_enq      TYPE TABLE OF seqg3,
        l_enq       TYPE seqg3.

  CLEAR : e_locked, e_name.

  CALL FUNCTION 'ENQUEUE_EZIM_DEPEND'
    EXPORTING
      mode_zim_depend = 'E'
      mandt           = sy-mandt
      pernr           = i_pernr
      x_pernr         = ' '
      _scope          = '2'
      _wait           = ' '
      _collect        = ' '
    EXCEPTIONS
      foreign_lock    = 1
      system_failure  = 2
      OTHERS          = 3.
  IF sy-subrc NE 0.
    e_locked = 'X'.

    CLEAR:   l_tabix, l_subrc, l_enq, l_key, l_uname.
    REFRESH: tb_enq.

    CALL FUNCTION 'ENQUEUE_READ'
      EXPORTING
        gclient = sy-mandt
        gname   = ' '
        garg    = ' '
        guname  = ' '
      IMPORTING
        number  = l_tabix
        subrc   = l_subrc
      TABLES
        enq     = tb_enq.

    IF sy-subrc EQ 0.
      CONCATENATE sy-mandt i_pernr
        INTO l_key.

      LOOP AT tb_enq INTO l_enq
        WHERE gname    = 'ZIM_DEPEND'
        AND   gobj     = 'EZIM_DEPEND'
        AND   garg(11) = l_key.
        l_uname = l_enq-guname.
        EXIT.
      ENDLOOP.

      CALL METHOD object_desc(
        EXPORTING
          i_plvar = '!!'
          i_otype = 'US'
          i_objid = l_uname
          i_date  = sy-datum
        IMPORTING
          e_stext = e_name ).

    ENDIF.
  ENDIF.


ENDMETHOD.


