CLASS ZCL_OLIMS_CLASS IMPLEMENTATION.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>ADD_USER_TEXT_LINE
* +-------------------------------------------------------------------------------------------------+
* | [<-()] E_USER_LINE                    TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
method ADD_USER_TEXT_LINE.

  data: tan_date(10)  type c,
        tan_time(8)   type c,
        tan_uname     type stext,
        tan_realo     type realo,
        l_lines       type i,
        l_length      type i.

  write sy-datlo to tan_date dd/mm/yyyy.
  write sy-timlo to tan_time.
  move sy-uname to tan_realo.
  call function 'RH_READ_OBJECT'
    exporting
      plvar           = '!!'
      otype           = 'US'
      realo           = tan_realo
      check_stru_auth = ' '
    importing
      stext           = tan_uname
    exceptions
      not_found       = 1
      others          = 2.
  if sy-subrc <> 0.
    clear tan_uname.
  endif.

  clear e_user_line.
  concatenate 'Note created by' tan_uname '('
              into e_user_line separated by ' '.
  concatenate e_user_line sy-uname ')'
              into e_user_line.
  concatenate e_user_line 'on' tan_date 'at' tan_time
              into e_user_line separated by ' '.


endmethod.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>CONVERT_STRING_TO_TABLE
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_STRING                       TYPE        STRINGVAL
* | [--->] I_APPEND                       TYPE        CHAR1
* | [--->] I_LINE_SIZE                    TYPE        I
* | [<---] E_TABLE                        TYPE        TABLE
* +--------------------------------------------------------------------------------------</SIGNATURE>
method CONVERT_STRING_TO_TABLE.

  data: abap_linesize     type i,
        data_ref          type ref to data,
        total_length      type i,
        line_size_used    type i,
        lt_longs          type table_of_strings,
        l_longs           type string,
        index(3)          type n,
        act_index         type sytabix,
        length            type sytabix,
        maxlen            type sytabix,
        finish(1)         type c,
        num(2)            type n,
        stream_text       type string.


  field-symbols: <wa> type any.

  total_length = strlen( i_string ).
  check total_length > 0.

  create data data_ref like line of e_table.
  assign data_ref->* to <wa>.
  describe field <wa> length abap_linesize in character mode.

  if ( i_line_size <= 0 ) or
     ( i_line_size > abap_linesize ).
    line_size_used = abap_linesize.
  else.
    line_size_used = i_line_size.
  endif.

  if i_append is initial.
    clear e_table[].
  endif.


  clear   : lt_longs.
  refresh : lt_longs.
  l_longs = i_string.
  split  i_string at  cl_abap_char_utilities=>newline
         into table  lt_longs .
  loop at lt_longs into l_longs.
    length = strlen( l_longs ).
    if length <= line_size_used.
      <wa> = l_longs.
      concatenate <wa> cl_abap_char_utilities=>cr_lf into <wa>.
      append <wa> to e_table.
    else.
      act_index = 0.
      while act_index < length.
        maxlen = length - act_index.
        if maxlen > line_size_used.
          maxlen = line_size_used.
        endif.
        <wa> = l_longs+act_index(maxlen).
        clear finish.
        index = line_size_used - 1.
        while finish  <> 'X' and index <> 0.
          if <wa>+index(1) = ' '.
            finish = 'X'.
          endif.
          index = index - 1.
        endwhile.
        index = index + 1.
        if index <> 0.
          <wa> = <wa>(index).
          append <wa> to e_table.
          act_index = act_index + index + 1.
        else.
          concatenate <wa> cl_abap_char_utilities=>cr_lf into <wa>.
          append <wa> to e_table.
          act_index = act_index + line_size_used.
        endif.
      endwhile.
    endif.
  endloop.


endmethod.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>CONVERT_STRING_TO_TABLE_HTML
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_STRING                       TYPE        STRINGVAL
* | [--->] I_APPEND                       TYPE        CHAR1
* | [--->] I_LINE_SIZE                    TYPE        I
* | [<---] E_TABLE                        TYPE        TABLE
* +--------------------------------------------------------------------------------------</SIGNATURE>
method CONVERT_STRING_TO_TABLE_HTML.

  data: abap_linesize     type i,
        data_ref          type ref to data,
        total_length      type i,
        line_size_used    type i,
        lt_longs          type table_of_strings,
        l_longs           type string,
        index(3)          type n,
        act_index         type sytabix,
        length            type sytabix,
        maxlen            type sytabix,
        finish(1)         type c,
        num(2)            type n,
        stream_text       type string.


  field-symbols: <wa> type any.

  total_length = strlen( i_string ).
  check total_length > 0.

  create data data_ref like line of e_table.
  assign data_ref->* to <wa>.
  describe field <wa> length abap_linesize in character mode.

  if ( i_line_size <= 0 ) or
     ( i_line_size > abap_linesize ).
    line_size_used = abap_linesize.
  else.
    line_size_used = i_line_size.
  endif.

  if i_append is initial.
    clear e_table[].
  endif.


  clear   : lt_longs.
  refresh : lt_longs.
  l_longs = i_string.
  split  i_string at  cl_abap_char_utilities=>newline
         into table  lt_longs .
  loop at lt_longs into l_longs.
    length = strlen( l_longs ).
    if length <= line_size_used.
      <wa> = l_longs.
      append <wa> to e_table.
    else.
      act_index = 0.
      while act_index < length.
        maxlen = length - act_index.
        if maxlen > line_size_used.
          maxlen = line_size_used.
        endif.
        <wa> = l_longs+act_index(maxlen).
        clear finish.
        index = line_size_used - 1.
        while finish  <> 'X' and index <> 0.
          if <wa>+index(1) = ' '.
            finish = 'X'.
          endif.
          index = index - 1.
        endwhile.
        index = index + 1.
        if index <> 0.
          <wa> = <wa>(index).
          append <wa> to e_table.
          act_index = act_index + index + 1.
        else.
          append <wa> to e_table.
          act_index = act_index + line_size_used.
        endif.
      endwhile.
    endif.

    append '<br />' to e_table.
  endloop.


endmethod.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>CREATE_REMINDER
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_ASS_TO                       TYPE        ZIM_IM_ROLE(optional)
* | [--->] I_ASS_EMP                      TYPE        PERSNO(optional)
* | [--->] I_NOTE_CAT                     TYPE        ZIM_NOTE_CATEGORY(optional)
* | [--->] I_RULE                         TYPE        ZIM_NOTE_BUSINESS_RULE(optional)
* | [--->] I_DOC_UNIQUE                   TYPE        ZIM_DOC_UNIQUE(optional)
* | [--->] I_PERNR                        TYPE        PERSNO
* | [--->] I_INCIDENT                     TYPE        ZHR_INC_IDENTNR
* | [--->] I_REM                          TYPE        ZIM_REM
* | [--->] I_UPDATE                       TYPE        CHAR1
* | [--->] I_DAYS_OVERDUE                 TYPE        INT4(optional)
* | [--->] I_REPORT                       TYPE        CHAR1(optional)
* | [--->] I_DUE_DATE                     TYPE        DATUM(optional)
* | [<---] E_REPORT                       TYPE        ZIM_REM_REPORT
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD create_reminder.

  DATA : l_in_rem               TYPE zim_in_rem,
         l_rem_seq_no           TYPE zim_seq_no2,
         l_action(1)            TYPE c,
         l_subrc                TYPE subrc,
         l_error(1)             TYPE c.

  CLEAR e_report.

* Check to determine if the reminder already exists
  SELECT SINGLE * FROM zim_in_rem
         INTO l_in_rem
         WHERE pernr         = i_pernr
           AND incident      = i_incident
           AND doc_unique    = i_doc_unique
           AND note_cat      = i_note_cat
           AND business_rule = i_rule
           AND message_type  = 'B'
           AND note_comp     = ' '.
  IF sy-subrc = 0.
    IF i_report IS NOT INITIAL AND
       i_days_overdue GT 0.
      MOVE-CORRESPONDING l_in_rem TO e_report.
      e_report-days_overdue = i_days_overdue.
      e_report-due_date     = i_due_date.
    ENDIF.
    RETURN.
  ENDIF.

* Create a reminder
  SELECT MAX( seq_no ) FROM zim_in_rem
         INTO l_rem_seq_no
         WHERE pernr    = i_pernr
           AND incident = i_incident
           AND ass_to   = i_ass_to.
  IF sy-subrc NE 0.
    l_rem_seq_no = 1.
  ELSE.
    ADD 1 TO l_rem_seq_no.
  ENDIF.
  l_action = 'I'.

  CLEAR l_in_rem.
  l_in_rem-pernr         = i_pernr.
  l_in_rem-incident      = i_incident.
  l_in_rem-seq_no        = l_rem_seq_no.
  l_in_rem-ass_to        = i_ass_to.
  l_in_rem-ass_emp       = i_ass_emp.
  l_in_rem-doc_unique    = i_doc_unique.
  l_in_rem-created_date  = sy-datum.
  l_in_rem-created_by    = sy-uname.
  l_in_rem-note_cat      = i_note_cat.
  l_in_rem-business_rule = i_rule.
  l_in_rem-message_type  = 'B'.
  l_in_rem-action        = i_rem-action.

  MOVE-CORRESPONDING l_in_rem TO e_report.
  e_report-days_overdue  = i_days_overdue.
  e_report-due_date      = i_due_date.

  IF i_update IS NOT INITIAL.
    MODIFY zim_in_rem FROM l_in_rem.
    IF sy-subrc NE 0.
      l_subrc = sy-subrc.
      ROLLBACK WORK.
      CONCATENATE 'Error occurred when updating ZIM_IN_REM'
                  'Return code ' l_subrc
            INTO  e_report-proc_message.
    ELSE.
      CALL METHOD save_in_rem_log(
        EXPORTING
          i_action = l_action
          i_in_rem = l_in_rem
        IMPORTING
          e_error  = l_error ).
      IF l_error IS NOT INITIAL.
        ROLLBACK WORK.
        e_report-proc_message = 'Error occurred when updating ZIM_IN_REM_LOG'.
      ENDIF.
    ENDIF.

  ENDIF.


ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>CREATE_REMINDER_ACTION
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_ASS_TO                       TYPE        ZIM_IM_ROLE(optional)
* | [--->] I_ASS_EMP                      TYPE        PERSNO(optional)
* | [--->] I_NOTE_CAT                     TYPE        ZIM_NOTE_CATEGORY(optional)
* | [--->] I_RULE                         TYPE        ZIM_NOTE_BUSINESS_RULE(optional)
* | [--->] I_DOC_UNIQUE                   TYPE        ZIM_DOC_UNIQUE(optional)
* | [--->] I_PERNR                        TYPE        PERSNO
* | [--->] I_INCIDENT                     TYPE        ZHR_INC_IDENTNR
* | [--->] I_REVIEW_DATE                  TYPE        DATUM(optional)
* | [--->] I_DELETE                       TYPE        CHAR1(optional)
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD create_reminder_action.

  DATA : l_in_rem               TYPE zim_in_rem,
         l_rem_seq_no           TYPE zim_seq_no2,
         l_action(1)            TYPE c,
         l_subrc                TYPE subrc,
         l_error(1)             TYPE c,
         l_zim_rem              TYPE zim_rem,
         l_found(1)             TYPE c.


  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = i_note_cat
           AND business_rule = i_rule.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS NOT INITIAL.
    RETURN.
  ENDIF.

* Check to determine if the reminder already exists
  SELECT SINGLE * FROM zim_in_rem
         INTO l_in_rem
         WHERE pernr         = i_pernr
           AND incident      = i_incident
           AND doc_unique    = i_doc_unique
           AND note_cat      = i_note_cat
           AND business_rule = i_rule
           AND message_type  = 'A'.
  IF sy-subrc = 0.
    l_found = 'X'.
  ENDIF.

* No update if a record exists
  IF l_found  IS NOT INITIAL  AND
     i_delete IS INITIAL.
    RETURN.
  ENDIF.

* Delete any existing reminders and create a new one.
  IF l_found  IS NOT INITIAL  AND
     i_delete IS NOT INITIAL.
    DELETE zim_in_rem FROM l_in_rem.
    IF sy-subrc NE 0.
      l_subrc = sy-subrc.
      ROLLBACK WORK.
      MESSAGE ID 'ZZ' TYPE 'E' NUMBER 999
              WITH 'Error occurred when updating ZIM_IN_REM'
                   'Return code ' l_subrc.
    ELSE.
      CALL METHOD save_in_rem_log(
        EXPORTING
          i_action = 'D'
          i_in_rem = l_in_rem
        IMPORTING
          e_error  = l_error ).
      IF l_error IS NOT INITIAL.
        ROLLBACK WORK.
        MESSAGE ID 'ZZ' TYPE 'E' NUMBER 999
                WITH 'Error occurred when updating ZIM_IN_REM_LOG'.
      ENDIF.
    ENDIF.
  ENDIF.
  WAIT UP TO 1 SECONDS.

* Create a reminder
  SELECT MAX( seq_no ) FROM zim_in_rem
         INTO l_rem_seq_no
         WHERE pernr    = i_pernr
           AND incident = i_incident
           AND ass_to   = i_ass_to.
  IF sy-subrc NE 0.
    l_rem_seq_no = 1.
  ELSE.
    ADD 1 TO l_rem_seq_no.
  ENDIF.
  l_action = 'I'.

  CLEAR l_in_rem.
  l_in_rem-pernr         = i_pernr.
  l_in_rem-incident      = i_incident.
  l_in_rem-seq_no        = l_rem_seq_no.
  l_in_rem-ass_to        = i_ass_to.
  l_in_rem-ass_emp       = i_ass_emp.
  l_in_rem-doc_unique    = i_doc_unique.
  l_in_rem-created_date  = sy-datum.
  l_in_rem-created_by    = sy-uname.
  l_in_rem-note_cat      = i_note_cat.
  l_in_rem-business_rule = i_rule.
  l_in_rem-review_date   = i_review_date.
  l_in_rem-message_type  = 'A'.
  l_in_rem-action        = l_zim_rem-action.

  MODIFY zim_in_rem FROM l_in_rem.
  IF sy-subrc NE 0.
    l_subrc = sy-subrc.
    ROLLBACK WORK.
    MESSAGE ID 'ZZ' TYPE 'E' NUMBER 999
               WITH 'Error occurred when updating ZIM_IN_REM'
                    'Return code ' l_subrc.
  ELSE.
    CALL METHOD save_in_rem_log(
      EXPORTING
        i_action = l_action
        i_in_rem = l_in_rem
      IMPORTING
        e_error  = l_error ).
    IF l_error IS NOT INITIAL.
      ROLLBACK WORK.
      MESSAGE ID 'ZZ' TYPE 'E' NUMBER 999
                 WITH 'Error occurred when updating ZIM_IN_REM_LOG'.
    ENDIF.
  ENDIF.



ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>DELETE_REMINDER
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_REM                          TYPE        ZIM_IN_REM
* | [<---] E_REPORT                       TYPE        ZIM_REM_REPORT
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD delete_reminder.

  DATA : l_subrc            TYPE subrc,
         l_error(1)         type c.

  CLEAR e_report.
  MOVE-CORRESPONDING i_rem TO e_report.
  e_report-proc_message = 'Reminder Deleted'.

  DELETE zim_in_rem FROM i_rem.
  IF sy-subrc NE 0.
    l_subrc = sy-subrc.
    ROLLBACK WORK.
    CONCATENATE 'Error occurred when deleting ZIM_IN_REM'
                'Return code ' l_subrc
          INTO  e_report-proc_message.
  ELSE.
    CALL METHOD save_in_rem_log(
      EXPORTING
        i_action = 'D'
        i_in_rem = i_rem
      IMPORTING
        e_error  = l_error ).
    IF l_error IS NOT INITIAL.
      ROLLBACK WORK.
      e_report-proc_message = 'Error occurred when updating ZIM_IN_REM_LOG'.
    ENDIF.
  ENDIF.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>DETERMINE_DOC_DISPLAY
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_USER_GROUP                   TYPE        ZIM_ACCESS_CATEGORY
* | [<---] E_CAT_DISPLAY                  TYPE        ZIM_CATEGORY_RANGE_T
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD DETERMINE_DOC_DISPLAY.

  DATA : tb_cat             TYPE STANDARD TABLE OF zim_cat,
         l_cat              TYPE zim_cat,
         l_range            TYPE zim_category_range.

  REFRESH e_cat_display.

  SELECT * FROM zim_cat
         INTO TABLE tb_cat
         WHERE user_group = i_user_group.
  CLEAR l_range.
  l_range-sign     = 'I'.
  l_range-option   = 'EQ'.
  LOOP AT tb_cat INTO l_cat.
    l_range-low     = l_cat-ltr_category.
    APPEND l_range TO e_cat_display.
  ENDLOOP.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>DETERMINE_DOC_UPDATE
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_USER_GROUP                   TYPE        ZIM_ACCESS_CATEGORY
* | [<---] E_CAT_UPDATE                   TYPE        ZIM_CATEGORY_RANGE_T
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD determine_doc_update.

  DATA : tb_cat             TYPE STANDARD TABLE OF zim_cat,
         l_cat              TYPE zim_cat,
         l_range            TYPE zim_category_range.

  REFRESH e_cat_update.

  SELECT * FROM zim_cat
         INTO TABLE tb_cat
         WHERE user_group = i_user_group
           AND document_access = 'U'.
  CLEAR l_range.
  l_range-sign     = 'I'.
  l_range-option   = 'EQ'.
  LOOP AT tb_cat INTO l_cat.
    l_range-low     = l_cat-ltr_category.
    APPEND l_range TO e_cat_update.
  ENDLOOP.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>DETERMINE_MEET_DISPLAY
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_USER_GROUP                   TYPE        ZIM_ACCESS_CATEGORY
* | [<---] E_MEET_DISPLAY                 TYPE        ZIM_MEET_RANGE_T
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD DETERMINE_MEET_DISPLAY.

  DATA : tb_meet            TYPE STANDARD TABLE OF zim_meet,
         l_meet             TYPE zim_meet,
         l_range            TYPE zim_meet_range.

  REFRESH e_meet_display.

  SELECT * FROM zim_meet
         INTO TABLE tb_meet
         WHERE user_group  = i_user_group.
  CLEAR l_range.
  l_range-sign     = 'I'.
  l_range-option   = 'EQ'.
  LOOP AT tb_meet INTO l_meet.
    l_range-low     = l_meet-meet_type.
    APPEND l_range TO e_meet_display.
  ENDLOOP.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>DETERMINE_MEET_UPDATE
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_USER_GROUP                   TYPE        ZIM_ACCESS_CATEGORY
* | [<---] E_MEET_UPDATE                  TYPE        ZIM_MEET_RANGE_T
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD DETERMINE_MEET_UPDATE.

  DATA : tb_meet            TYPE STANDARD TABLE OF zim_meet,
         l_meet             TYPE zim_meet,
         l_range            TYPE zim_meet_range.

  REFRESH e_meet_update.

  SELECT * FROM zim_meet
         INTO TABLE tb_meet
         WHERE user_group  = i_user_group
           AND meet_access = 'U'.
  CLEAR l_range.
  l_range-sign     = 'I'.
  l_range-option   = 'EQ'.
  LOOP AT tb_meet INTO l_meet.
    l_range-low     = l_meet-meet_type.
    APPEND l_range TO e_meet_update.
  ENDLOOP.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>DETERMINE_USER_GROUP
* +-------------------------------------------------------------------------------------------------+
* | [<---] E_USER_GROUP                   TYPE        ZIM_ACCESS_CATEGORY
* | [<---] E_NOTE_CODE                    TYPE        ZIM_NOTE_DEFAULT
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD determine_user_group.


  SELECT SINGLE user_group note_code FROM zim_user
         INTO (e_user_group, e_note_code)
         WHERE tcode = sy-tcode.
  IF sy-subrc NE 0.
    CLEAR : e_user_group, e_note_code.
  ENDIF.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>GENERATE_REMINDERS_CM
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_PERNR                        TYPE        PERSNO
* | [--->] I_INCIDENT                     TYPE        ZHR_INC_IDENTNR
* | [--->] I_UPDATE                       TYPE        CHAR1(optional)
* | [--->] I_DATE                         TYPE        DATUM
* | [--->] I_REPORT                       TYPE        CHAR1(optional)
* | [<---] TB_REPORT                      TYPE        ZIM_REM_REPORT_T
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD generate_reminders_cm.

  DATA : l_mast             TYPE zim_in_mast,
         l_incident         TYPE zim_incident,
         l_pa0001           TYPE pa0001,
         tb_zim_in_cert     TYPE STANDARD TABLE OF zim_in_cert,
         tb_zim_in_cap      TYPE STANDARD TABLE OF zim_in_cap,
         tb_zim_in_claim    TYPE STANDARD TABLE OF zim_in_claim,
         tb_zim_in_cm       TYPE STANDARD TABLE OF zim_in_cm,
         tb_zim_in_ip       TYPE STANDARD TABLE OF zim_in_ip,
         l_report           TYPE zim_rem_report,
         l_zim_in_cert      TYPE zim_in_cert,
         l_cert             TYPE zim_in_cert,
         l_zim_in_cap       TYPE zim_in_cap,
         l_cap              TYPE zim_in_cap,
         l_zim_in_claim     TYPE zim_in_claim,
         l_zim_in_cm        TYPE zim_in_cm,
         l_zim_in_ip        TYPE zim_in_ip,
         l_zim_in_rem       TYPE zim_in_rem,
         l_zim_in_doc_in    TYPE zim_in_doc_in,
         l_zim_rem          TYPE zim_rem,
         l_days             TYPE i,
         l_days2            TYPE i,
         l_date             TYPE d,
         l_subrc            TYPE sy-subrc,
         l_days_overdue     TYPE int4,
         l_lines            TYPE i,
         l_count            TYPE i,
         l_doc_unique       TYPE zim_doc_unique,
         l_send(1)          TYPE c,
         l_admin(1)         TYPE c.



  REFRESH tb_report.

  SELECT SINGLE * FROM zim_in_mast
         INTO l_mast
         WHERE pernr    = i_pernr
           AND incident = i_incident.
  IF sy-subrc NE 0.
    RETURN.
  ENDIF.

* No reminders for One-off incidents
  IF l_mast-inc_type = 'O'.
    RETURN.
  ENDIF.


* Retrieve lookup details

  SELECT SINGLE * FROM pa0001
         INTO l_pa0001
         WHERE pernr = i_pernr
           AND begda LE sy-datum
           AND endda GE sy-datum.
  IF sy-subrc NE 0.
    CLEAR l_pa0001.
  ENDIF.


  SELECT SINGLE * FROM zim_incident
         INTO l_incident
         WHERE pernr    = i_pernr
           AND incident = i_incident.
  IF sy-subrc NE 0.
    RETURN.
  ENDIF.

  SELECT SINGLE * FROM zim_in_cm
         INTO l_zim_in_cm
         WHERE pernr    = i_pernr
           AND incident = i_incident.
  IF sy-subrc NE 0.
    RETURN.
  ENDIF.

  SELECT * FROM zim_in_claim
         INTO TABLE tb_zim_in_claim
         WHERE pernr    = i_pernr
           AND incident = i_incident.
  SORT tb_zim_in_claim BY claim_type
                          begda      DESCENDING.

  SELECT * FROM zim_in_ip
         INTO TABLE tb_zim_in_ip
         WHERE pernr    = i_pernr
           AND incident = i_incident.
  SORT tb_zim_in_ip BY record_type
                       begda      DESCENDING.

  SELECT * FROM zim_in_cert
         INTO TABLE tb_zim_in_cert
         WHERE pernr    = i_pernr
           AND incident = i_incident
           AND inactive = ' '.
  SELECT * FROM zim_in_cap
         APPENDING CORRESPONDING FIELDS OF TABLE tb_zim_in_cert
         WHERE pernr    = i_pernr
           AND incident = i_incident
           AND inactive = ' '.
  SORT tb_zim_in_cert BY mc_date   DESCENDING
                         date_from DESCENDING
                         date_to   DESCENDING.


  IF ( l_pa0001-persk GE 'XG' AND
       l_pa0001-persk LE 'XT' ) or
       l_pa0001-persk  = 'XX'  or
       l_pa0001-persk  = 'XY' .   " CR3185 PMP Project
    l_admin = 'X'.
  ELSE.
    CLEAR l_admin.
  ENDIF.

* 01 - Category 80      - Case Management
*      Business Rule 02 - 266 Days after the Date of Disablement


* 03 - Category 80      - Case Management
*      Business Rule 04 - 30 Days prior to WC End Date
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '80'
           AND business_rule = '04'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_zim_in_cm-wc_status = 'O'.
      l_days = l_zim_in_cm-wc_end_date - i_date.
      IF l_days LE l_zim_rem-rem_days.
* Only create a reminder if one has not already been created
        SELECT SINGLE * FROM zim_in_rem
               INTO l_zim_in_rem
               WHERE pernr         = i_pernr
                 AND incident      = i_incident
                 AND ass_to        = 'W'
                 AND ass_emp       = l_zim_in_cm-wc_advisor
                 AND doc_unique    = ' '
                 AND note_cat      = l_zim_rem-note_cat
                 AND business_rule = l_zim_rem-business_rule
                 AND message_type  = 'B'.
        IF sy-subrc NE 0.
          CALL METHOD create_reminder
            EXPORTING
              i_ass_to   = 'W'
              i_ass_emp  = l_zim_in_cm-wc_advisor
              i_note_cat = l_zim_rem-note_cat
              i_rule     = l_zim_rem-business_rule
              i_pernr    = i_pernr
              i_incident = i_incident
              i_rem      = l_zim_rem
              i_update   = i_update
            IMPORTING
              e_report   = l_report.
          IF l_report IS NOT INITIAL.
            APPEND l_report TO tb_report.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.


* 05 - Category 80      - Case Management
*      Business Rule 06 - 5 working days prior to expiry of
*                         the WorkCover certificate
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '80'
           AND business_rule = '06'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    CLEAR l_zim_in_cert.
    LOOP AT tb_zim_in_cert INTO l_zim_in_cert.
      EXIT.
    ENDLOOP.
    IF sy-subrc = 0.
      IF l_zim_in_cm-wc_status = 'O'.
        IF l_zim_in_cert-status = 'U'  OR
           l_zim_in_cert-status = 'SD' OR
           l_zim_in_cert-status = 'C'  OR
           l_zim_in_cert-status = 'N'.
          l_days = l_zim_rem-rem_days * -1.
          CALL FUNCTION 'BKK_ADD_WORKINGDAY'
            EXPORTING
              i_date      = l_zim_in_cert-date_to
              i_days      = l_days
              i_calendar1 = 'AU'
            IMPORTING
              e_date      = l_date
              e_return    = l_subrc.

          IF l_date LE i_date.
            CALL METHOD create_reminder
              EXPORTING
                i_ass_to   = 'W'
                i_ass_emp  = l_zim_in_cm-wc_advisor
                i_note_cat = l_zim_rem-note_cat
                i_rule     = l_zim_rem-business_rule
                i_pernr    = i_pernr
                i_incident = i_incident
                i_rem      = l_zim_rem
                i_update   = i_update
              IMPORTING
                e_report   = l_report.
            IF l_report IS NOT INITIAL.
              APPEND l_report TO tb_report.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 06 - Category 80      - Case Management
*      Business Rule 07 - 7 Days after claim status declined
*                         if letter not sent
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '80'
           AND business_rule = '07'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    CLEAR l_zim_in_claim.
    LOOP AT tb_zim_in_claim INTO l_zim_in_claim
            WHERE claim_type = 'W'.
      EXIT.
    ENDLOOP.
    IF l_zim_in_claim-stat      = '7' AND
       l_zim_in_claim-sent_date IS INITIAL.
      l_days = i_date - l_zim_in_claim-date_updated.
      IF l_days GE l_zim_rem-rem_days.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to   = 'W'
            i_ass_emp  = l_zim_in_cm-wc_advisor
            i_note_cat = l_zim_rem-note_cat
            i_rule     = l_zim_rem-business_rule
            i_pernr    = i_pernr
            i_incident = i_incident
            i_rem      = l_zim_rem
            i_update   = i_update
          IMPORTING
            e_report   = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>GENERATE_REMINDERS_DEPLOY
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_PERNR                        TYPE        PERSNO
* | [--->] I_INCIDENT                     TYPE        ZHR_INC_IDENTNR
* | [--->] I_UPDATE                       TYPE        CHAR1(optional)
* | [--->] I_DATE                         TYPE        DATUM
* | [--->] I_REPORT                       TYPE        CHAR1(optional)
* | [<---] TB_REPORT                      TYPE        ZIM_REM_REPORT_T
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD generate_reminders_deploy.

  DATA : l_mast             TYPE zim_in_mast,
         l_incident         TYPE zim_incident,
         l_pa0001           TYPE pa0001,
         tb_zim_in_deploy   TYPE STANDARD TABLE OF zim_in_deploy,
         l_report           TYPE zim_rem_report,
         l_zim_in_deploy    TYPE zim_in_deploy,
         l_advisor          TYPE zim_advisor,
         l_zim_in_rem       TYPE zim_in_rem,
         l_zim_rem          TYPE zim_rem,
         l_days             TYPE i,
         l_days2            TYPE i,
         l_date             TYPE d,
         l_subrc            TYPE sy-subrc,
         l_days_overdue     TYPE int4,
         l_lines            TYPE i,
         l_count            TYPE i,
         l_doc_unique       TYPE zim_doc_unique,
         l_send(1)          TYPE c.



  REFRESH tb_report.

  SELECT SINGLE * FROM zim_in_mast
         INTO l_mast
         WHERE pernr    = i_pernr
           AND incident = i_incident.
  IF sy-subrc NE 0.
    RETURN.
  ENDIF.

* No reminders for One-off incidents
  IF l_mast-inc_type = 'O'.
    RETURN.
  ENDIF.


* Retrieve lookup details

  SELECT SINGLE * FROM zim_in_deploy
         INTO l_zim_in_deploy
         WHERE pernr    = i_pernr
           AND incident = i_incident.
  IF sy-subrc NE 0.
    RETURN.
  ENDIF.

  SELECT SINGLE * FROM zim_advisor
         INTO l_advisor
         WHERE ima    = l_mast-ima.
  IF sy-subrc NE 0.
    CLEAR l_advisor.
  ENDIF.


* 01 - Category 20      - Deployment Unit
*      Business Rule 20 - 5 working days after Deployment Referral was
*      sent
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '20'
           AND business_rule = '20'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_zim_in_deploy-sign_ref_recd_dt IS INITIAL AND
       l_zim_in_deploy-ref_sent_date IS NOT INITIAL AND
       l_zim_in_deploy-date_closed IS INITIAL.

      l_days = l_zim_rem-rem_days.
      CALL FUNCTION 'Z_BKK_ADD_WORKINGDAY'
        EXPORTING
          i_date      = l_zim_in_deploy-ref_sent_date
          i_days      = l_days
          i_calendar1 = 'AU'
        IMPORTING
          e_date      = l_date
          e_return    = l_subrc.

      IF i_date GE l_date.
        l_days_overdue = i_date - l_date.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to       = 'U'
            i_ass_emp      = l_zim_in_deploy-case_officer
            i_note_cat     = l_zim_rem-note_cat
            i_rule         = l_zim_rem-business_rule
            i_pernr        = i_pernr
            i_incident     = i_incident
            i_rem          = l_zim_rem
            i_update       = i_update
            i_days_overdue = l_days_overdue
            i_due_date     = l_date
            i_report       = i_report
          IMPORTING
            e_report       = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 02 - Category 20      - Deployment Unit
*      Business Rule 21 - CMD not notified 1 working day of the
*      Deployment Unit accepting the case
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '20'
           AND business_rule = '21'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_zim_in_deploy-date_closed IS INITIAL AND
       l_zim_in_deploy-case_accepted_dt IS NOT INITIAL AND
       l_zim_in_deploy-cmd_notify_dt IS INITIAL.

      l_days = l_zim_rem-rem_days.
      CALL FUNCTION 'Z_BKK_ADD_WORKINGDAY'
        EXPORTING
          i_date      = l_zim_in_deploy-case_accepted_dt
          i_days      = l_days
          i_calendar1 = 'AU'
        IMPORTING
          e_date      = l_date
          e_return    = l_subrc.


      IF i_date GE l_date.
        l_days_overdue = i_date - l_date.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to       = 'U'
            i_ass_emp      = l_zim_in_deploy-case_officer
            i_note_cat     = l_zim_rem-note_cat
            i_rule         = l_zim_rem-business_rule
            i_pernr        = i_pernr
            i_incident     = i_incident
            i_rem          = l_zim_rem
            i_update       = i_update
            i_days_overdue = l_days_overdue
            i_due_date     = l_date
            i_report       = i_report
          IMPORTING
            e_report       = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 03 - Category 20      - Deployment Unit
*      Business Rule 22 - Emp not contacted 1 working day of the
*      Deployment Unit accepting the case
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '20'
           AND business_rule = '22'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_zim_in_deploy-date_closed IS INITIAL AND
       l_zim_in_deploy-case_accepted_dt IS NOT INITIAL AND
       ( l_zim_in_deploy-first_contact_dt IS INITIAL OR
         l_zim_in_deploy-last_contact_dt IS INITIAL ).

      l_days = l_zim_rem-rem_days.
      CALL FUNCTION 'Z_BKK_ADD_WORKINGDAY'
        EXPORTING
          i_date      = l_zim_in_deploy-case_accepted_dt
          i_days      = l_days
          i_calendar1 = 'AU'
        IMPORTING
          e_date      = l_date
          e_return    = l_subrc.

      IF i_date GE l_date.
        l_days_overdue = i_date - l_date.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to       = 'U'
            i_ass_emp      = l_zim_in_deploy-case_officer
            i_note_cat     = l_zim_rem-note_cat
            i_rule         = l_zim_rem-business_rule
            i_pernr        = i_pernr
            i_incident     = i_incident
            i_rem          = l_zim_rem
            i_update       = i_update
            i_days_overdue = l_days_overdue
            i_due_date     = l_date
            i_report       = i_report
          IMPORTING
            e_report       = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 04 - Category 20      - Deployment Unit
