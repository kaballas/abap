    CLEAR:   l_tabix, l_subrc, l_enq, l_key, l_uname.
    REFRESH: tb_enq.

    CALL FUNCTION 'ENQUEUE_READ'
      EXPORTING
        gclient = sy-mandt
        gname   = ' '
        garg    = ' '
        guname  = ' '
      IMPORTING
        number  = l_tabix
        subrc   = l_subrc
      TABLES
        enq     = tb_enq.

    IF sy-subrc EQ 0.
      CONCATENATE sy-mandt i_pernr i_incident
                  i_seq_no
        INTO l_key.

      LOOP AT tb_enq INTO l_enq
        WHERE gname    = 'ZIM_IN_MEDRPT'
        AND   gobj     = 'EZIM_IN_MEDRPT'
        AND   garg(24) = l_key.
        l_uname = l_enq-guname.
        EXIT.
      ENDLOOP.

      CALL METHOD object_desc(
        EXPORTING
          i_plvar = '!!'
          i_otype = 'US'
          i_objid = l_uname
          i_date  = sy-datum
        IMPORTING
          e_stext = e_name ).

    ENDIF.
  ENDIF.


ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>LOCK_IN_MTG
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_PERNR                        TYPE        PERSNO
* | [--->] I_INCIDENT                     TYPE        ZHR_INC_IDENTNR
* | [--->] I_MEET_SEQ_NO                  TYPE        ZGEN_SEQ_NO4
* | [--->] I_MEET_TYPE                    TYPE        ZIM_MEET_TYPE
* | [<---] E_LOCKED                       TYPE        CHAR1
* | [<---] E_NAME                         TYPE        STEXT
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD LOCK_IN_MTG.


  DATA: l_subrc     LIKE sy-subrc,
        l_tabix     LIKE sy-tabix,
        l_key(26)   TYPE c,
        l_uname(12) TYPE c,
        tb_enq      TYPE TABLE OF seqg3,
        l_enq       TYPE seqg3.

  clear : e_locked, e_name.

CALL FUNCTION 'ENQUEUE_EZIM_IN_MTG'
 EXPORTING
   MODE_ZIM_IN_MTG       = 'E'
   MANDT                 = SY-MANDT
   PERNR                 = i_pernr
   INCIDENT              = i_incident
   MEET_TYPE             = i_meet_type
   MEET_SEQ_NO           = i_meet_seq_no
   X_PERNR               = ' '
   X_INCIDENT            = ' '
   X_MEET_TYPE           = ' '
   X_MEET_SEQ_NO         = ' '
   _SCOPE                = '2'
   _WAIT                 = ' '
   _COLLECT              = ' '
 EXCEPTIONS
   FOREIGN_LOCK          = 1
   SYSTEM_FAILURE        = 2
   OTHERS                = 3
          .
IF sy-subrc <> 0.
    e_locked = 'X'.

    CLEAR:   l_tabix, l_subrc, l_enq, l_key, l_uname.
    REFRESH: tb_enq.

    CALL FUNCTION 'ENQUEUE_READ'
      EXPORTING
        gclient = sy-mandt
        gname   = ' '
        garg    = ' '
        guname  = ' '
      IMPORTING
        number  = l_tabix
        subrc   = l_subrc
      TABLES
        enq     = tb_enq.

    IF sy-subrc EQ 0.
      CONCATENATE sy-mandt i_pernr i_incident
                  i_meet_type i_meet_seq_no
        INTO l_key.

      LOOP AT tb_enq INTO l_enq
        WHERE gname    = 'ZIM_IN_MTG'
        AND   gobj     = 'EZIM_IN_MTG'
        AND   garg(26) = l_key.
        l_uname = l_enq-guname.
        EXIT.
      ENDLOOP.

      CALL METHOD object_desc(
        EXPORTING
          i_plvar = '!!'
          i_otype = 'US'
          i_objid = l_uname
          i_date  = sy-datum
        IMPORTING
          e_stext = e_name ).

    ENDIF.
  ENDIF.


ENDMETHOD.


