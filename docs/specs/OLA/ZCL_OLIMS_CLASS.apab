* 11 - Category 20      - Deployment Unit
*      Business Rule 30 - If Dep Mth has not created
*      14 days region decision was uploaded
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '20'
           AND business_rule = '30'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_zim_in_deploy-date_closed IS INITIAL AND
       l_zim_in_deploy-region_recd_dt IS NOT INITIAL AND
       l_zim_in_deploy-mth_mtg_held IS INITIAL.

      l_days = i_date - l_zim_in_deploy-region_recd_dt.

      IF l_days GE l_zim_rem-rem_days.
        l_days_overdue = l_days - l_zim_rem-rem_days.
        l_date = l_zim_in_deploy-region_recd_dt + l_zim_rem-rem_days.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to       = 'U'
            i_ass_emp      = l_zim_in_deploy-case_officer
            i_note_cat     = l_zim_rem-note_cat
            i_rule         = l_zim_rem-business_rule
            i_pernr        = i_pernr
            i_incident     = i_incident
            i_rem          = l_zim_rem
            i_update       = i_update
            i_days_overdue = l_days_overdue
            i_due_date     = l_date
            i_report       = i_report
          IMPORTING
            e_report       = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 12 - Category 20      - Deployment Unit
*      Business Rule 34 - 5 days before the initial meeting date
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '20'
           AND business_rule = '34'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_zim_in_deploy-first_mtg_dt IS NOT INITIAL AND
       l_zim_in_deploy-first_mtg_dt GT i_date      AND
       l_zim_in_deploy-date_closed IS INITIAL.

      l_days = l_zim_rem-rem_days * -1.
      CALL FUNCTION 'Z_BKK_ADD_WORKINGDAY'
        EXPORTING
          i_date      = l_zim_in_deploy-first_mtg_dt
          i_days      = l_days
          i_calendar1 = 'AU'
        IMPORTING
          e_date      = l_date
          e_return    = l_subrc.

      IF i_date GE l_date.

* Only create a reminder if one has not already been created
        SELECT SINGLE * FROM zim_in_rem
               INTO l_zim_in_rem
               WHERE pernr         = i_pernr
                 AND incident      = i_incident
                 AND ass_to        = 'O'
                 AND ass_emp       = l_zim_in_deploy-case_officer
                 AND note_cat      = l_zim_rem-note_cat
                 AND business_rule = l_zim_rem-business_rule
                 AND message_type  = 'B'.
        IF sy-subrc NE 0.
          CALL METHOD create_reminder
            EXPORTING
              i_ass_to   = 'O'
              i_ass_emp  = l_zim_in_deploy-case_officer
              i_note_cat = l_zim_rem-note_cat
              i_rule     = l_zim_rem-business_rule
              i_pernr    = i_pernr
              i_incident = i_incident
              i_rem      = l_zim_rem
              i_update   = i_update
              i_due_date = l_zim_in_deploy-first_mtg_dt
              i_report   = i_report
            IMPORTING
              e_report   = l_report.
          IF l_report IS NOT INITIAL.
            APPEND l_report TO tb_report.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 12 - Category 20      - Deployment Unit
*      Business Rule 35 - 5 days before the mid-point meeting date
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '20'
           AND business_rule = '35'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_zim_in_deploy-mth_case_rev_dt IS NOT INITIAL AND
       l_zim_in_deploy-mth_case_rev_dt GT i_date      AND
       l_zim_in_deploy-date_closed IS INITIAL.

      l_days = l_zim_rem-rem_days * -1.
      CALL FUNCTION 'Z_BKK_ADD_WORKINGDAY'
        EXPORTING
          i_date      = l_zim_in_deploy-mth_case_rev_dt
          i_days      = l_days
          i_calendar1 = 'AU'
        IMPORTING
          e_date      = l_date
          e_return    = l_subrc.

      IF i_date GE l_date.

* Only create a reminder if one has not already been created
        SELECT SINGLE * FROM zim_in_rem
               INTO l_zim_in_rem
               WHERE pernr         = i_pernr
                 AND incident      = i_incident
                 AND ass_to        = 'O'
                 AND ass_emp       = l_zim_in_deploy-case_officer
                 AND note_cat      = l_zim_rem-note_cat
                 AND business_rule = l_zim_rem-business_rule
                 AND message_type  = 'B'.
        IF sy-subrc NE 0.
          CALL METHOD create_reminder
            EXPORTING
              i_ass_to   = 'O'
              i_ass_emp  = l_zim_in_deploy-case_officer
              i_note_cat = l_zim_rem-note_cat
              i_rule     = l_zim_rem-business_rule
              i_pernr    = i_pernr
              i_incident = i_incident
              i_rem      = l_zim_rem
              i_update   = i_update
              i_due_date = l_zim_in_deploy-mth_case_rev_dt
              i_report   = i_report
            IMPORTING
              e_report   = l_report.
          IF l_report IS NOT INITIAL.
            APPEND l_report TO tb_report.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 12 - Category 20      - Deployment Unit
*      Business Rule 36 - 5 days before the final meeting date
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '20'
           AND business_rule = '36'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_zim_in_deploy-final_mtg_dt IS NOT INITIAL AND
       l_zim_in_deploy-final_mtg_dt GT i_date      AND
       l_zim_in_deploy-date_closed IS INITIAL.

      l_days = l_zim_rem-rem_days * -1.
      CALL FUNCTION 'Z_BKK_ADD_WORKINGDAY'
        EXPORTING
          i_date      = l_zim_in_deploy-final_mtg_dt
          i_days      = l_days
          i_calendar1 = 'AU'
        IMPORTING
          e_date      = l_date
          e_return    = l_subrc.

      IF i_date GE l_date.

* Only create a reminder if one has not already been created
        SELECT SINGLE * FROM zim_in_rem
               INTO l_zim_in_rem
               WHERE pernr         = i_pernr
                 AND incident      = i_incident
                 AND ass_to        = 'O'
                 AND ass_emp       = l_zim_in_deploy-case_officer
                 AND note_cat      = l_zim_rem-note_cat
                 AND business_rule = l_zim_rem-business_rule
                 AND message_type  = 'B'.
        IF sy-subrc NE 0.
          CALL METHOD create_reminder
            EXPORTING
              i_ass_to   = 'O'
              i_ass_emp  = l_zim_in_deploy-case_officer
              i_note_cat = l_zim_rem-note_cat
              i_rule     = l_zim_rem-business_rule
              i_pernr    = i_pernr
              i_incident = i_incident
              i_rem      = l_zim_rem
              i_update   = i_update
              i_due_date = l_zim_in_deploy-final_mtg_dt
              i_report   = i_report
            IMPORTING
              e_report   = l_report.
          IF l_report IS NOT INITIAL.
            APPEND l_report TO tb_report.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.


ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>GENERATE_REMINDERS_IM
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_PERNR                        TYPE        PERSNO
* | [--->] I_INCIDENT                     TYPE        ZHR_INC_IDENTNR
* | [--->] I_UPDATE                       TYPE        CHAR1(optional)
* | [--->] I_DATE                         TYPE        DATUM
* | [--->] I_REPORT                       TYPE        CHAR1(optional)
* | [<---] TB_REPORT                      TYPE        ZIM_REM_REPORT_T
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD generate_reminders_im.

  DATA : l_mast             TYPE zim_in_mast,
         l_pa0001           TYPE pa0001,
         tb_zim_in_cert     TYPE STANDARD TABLE OF zim_in_cert,
         tb_zim_in_cap      TYPE STANDARD TABLE OF zim_in_cap,
         tb_zim_in_mtg      TYPE STANDARD TABLE OF zim_in_mtg,
         tb_zim_in_imep     TYPE STANDARD TABLE OF zim_in_imep,
         tb_zim_in_prov     TYPE STANDARD TABLE OF zim_in_prov,
         tb_zim_in_req      TYPE STANDARD TABLE OF zim_in_req,
         tb_zim_rtwp        TYPE STANDARD TABLE OF zim_rtwp,
         tb_zim_in_ftc      TYPE STANDARD TABLE OF zim_in_ftc,
         tb_zim_in_rem      TYPE STANDARD TABLE OF zim_in_rem,
         tb_zim_in_ftcax    TYPE STANDARD TABLE OF zim_in_ftcax,
         tb_zim_in_claim    TYPE STANDARD TABLE OF zim_in_claim,
         tb_zim_in_deploy   TYPE STANDARD TABLE OF zim_in_deploy,
         l_report           TYPE zim_rem_report,
         l_zim_in_cert      TYPE zim_in_cert,
         l_cert             TYPE zim_in_cert,
         l_zim_in_cap       TYPE zim_in_cap,
         l_cap              TYPE zim_in_cap,
         l_zim_in_mtg       TYPE zim_in_mtg,
         l_zim_in_imep      TYPE zim_in_imep,
         l_zim_in_prov      TYPE zim_in_prov,
         l_zim_in_req       TYPE zim_in_req,
         l_zim_rtwp         TYPE zim_rtwp,
         l_zim_rtwp_grade   TYPE zim_rtwp_grade,
         l_zim_in_ftc       TYPE zim_in_ftc,
         l_zim_in_rem       TYPE zim_in_rem,
         l_zim_in_ftcax     TYPE zim_in_ftcax,
         l_zim_in_claim     TYPE zim_in_claim,
         l_zim_in_deploy    TYPE zim_in_deploy,
         l_zim_rem          TYPE zim_rem,
         l_days             TYPE i,
         l_due_date         TYPE d,
         l_days2            TYPE i,
         l_date             TYPE d,
         l_meet_date        TYPE d,
         l_subrc            TYPE sy-subrc,
         l_days_overdue     TYPE int4,
         l_lines            TYPE i,
         l_count            TYPE i,
         l_doc_unique       TYPE zim_doc_unique,
         l_advisor          TYPE zim_advisor,
         l_sima             TYPE persno,
         l_send(1)          TYPE c.



  REFRESH tb_report.

  SELECT SINGLE * FROM zim_in_mast
         INTO l_mast
         WHERE pernr    = i_pernr
           AND incident = i_incident.
  IF sy-subrc NE 0.
    RETURN.
  ENDIF.

* No reminders for One-off incidents
  IF l_mast-inc_type = 'O'.
    RETURN.
  ENDIF.

* Delete all existing reminders for closed cases
  IF l_mast-inc_status = 'C' AND
     i_update IS NOT INITIAL.
    SELECT * FROM zim_in_rem
           INTO TABLE tb_zim_in_rem
           WHERE pernr    = i_pernr
             AND incident = i_incident.
    LOOP AT tb_zim_in_rem INTO l_zim_in_rem
         WHERE note_cat NE '20'     " Deployment
           AND note_cat NE '30'     " Legal
           AND note_cat NE '80'     " Case Management
           AND note_cat NE '85'.    " Income Protection
      CALL METHOD delete_reminder
        EXPORTING
          i_rem    = l_zim_in_rem
        IMPORTING
          e_report = l_report.
      APPEND l_report TO tb_report.
    ENDLOOP.
    RETURN.
  ENDIF.

* No reminders for closed cases
  IF l_mast-inc_status = 'C'.
    RETURN.
  ENDIF.


* No new reminders for suspended cases
* A  - Category 99      - General Reminders
*      Business Rule 10 - A suspended case is due to be reviewed

  IF l_mast-inc_status = 'S'.
    SELECT SINGLE * FROM zim_rem
           INTO l_zim_rem
           WHERE note_cat      = '99'
             AND business_rule = '10'.
    IF sy-subrc NE 0.
      l_zim_rem-inactive = 'X'.
    ENDIF.
    IF l_zim_rem-inactive IS INITIAL AND
       i_report IS INITIAL.                      " Not required for the report

      l_days = i_date - l_mast-last_act_date.
      IF l_days GT l_zim_rem-rem_days.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to   = 'I'
            i_ass_emp  = l_mast-ima
            i_note_cat = l_zim_rem-note_cat
            i_rule     = l_zim_rem-business_rule
            i_pernr    = i_pernr
            i_incident = i_incident
            i_rem      = l_zim_rem
            i_update   = i_update
          IMPORTING
            e_report   = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
    RETURN.
  ENDIF.

* Retrieve lookup details

  SELECT SINGLE * FROM pa0001
         INTO l_pa0001
         WHERE pernr = i_pernr
           AND begda LE sy-datum
           AND endda GE sy-datum.
  IF sy-subrc NE 0.
    CLEAR l_pa0001.
  ENDIF.

  SELECT * FROM zim_in_mtg
         INTO TABLE tb_zim_in_mtg
         WHERE pernr    = i_pernr
           AND incident = i_incident.
  SORT tb_zim_in_mtg BY meet_type
                        meet_date DESCENDING.

  CLEAR l_sima.
  SELECT SINGLE * FROM zim_advisor
         INTO l_advisor
         WHERE ima = l_mast-ima.
  IF sy-subrc = 0.
    l_sima = l_advisor-sima.
  ENDIF.
  IF l_sima IS INITIAL.
    l_sima = l_mast-ima.
  ENDIF.

  SELECT * FROM zim_in_cert
         INTO TABLE tb_zim_in_cert
         WHERE pernr    = i_pernr
           AND incident = i_incident
           AND inactive = ' '.
  SELECT * FROM zim_in_cap
         APPENDING CORRESPONDING FIELDS OF TABLE tb_zim_in_cert
         WHERE pernr    = i_pernr
           AND incident = i_incident
           AND inactive = ' '.
  SORT tb_zim_in_cert BY date_from DESCENDING
                         date_to   DESCENDING.
  LOOP AT tb_zim_in_cert INTO l_zim_in_cert.
    EXIT.
  ENDLOOP.


* 01 - Category 01      - Initial Assessment
*      Business Rule 01 - 3 Point contact has not been completed
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '01'
           AND business_rule = '01'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_mast-inc_status = 'T'  .
      CALL FUNCTION 'BKK_ADD_WORKINGDAY'
        EXPORTING
          i_date      = l_mast-reopened_date
          i_days      = 1
          i_calendar1 = 'AU'
        IMPORTING
          e_date      = l_date
          e_return    = l_subrc.
    ELSE.
      CALL FUNCTION 'BKK_ADD_WORKINGDAY'
        EXPORTING
          i_date      = l_mast-date_created
          i_days      = 1
          i_calendar1 = 'AU'
        IMPORTING
          e_date      = l_date
          e_return    = l_subrc.
    ENDIF.

    IF ( l_mast-inc_status = 'O'   OR
         l_mast-inc_status = 'T'   OR
         l_mast-inc_status = 'I' ) AND
         l_mast-ima IS NOT INITIAL AND
         l_date LE i_date          AND
         l_mast-three_point IS INITIAL.
      l_days_overdue = i_date - l_date.
      CALL METHOD create_reminder
        EXPORTING
          i_ass_to       = 'I'
          i_ass_emp      = l_mast-ima
          i_note_cat     = l_zim_rem-note_cat
          i_rule         = l_zim_rem-business_rule
          i_pernr        = i_pernr
          i_incident     = i_incident
          i_rem          = l_zim_rem
          i_update       = i_update
          i_days_overdue = l_days_overdue
          i_due_date     = l_date
          i_report       = i_report
        IMPORTING
          e_report       = l_report.
      IF l_report IS NOT INITIAL.
        APPEND l_report TO tb_report.
      ENDIF.
    ENDIF.
  ENDIF.

* 02 - Category 99      - General Reminders
*      Business Rule 01 - No activity performed for > 21 days
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '99'
           AND business_rule = '01'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_mast-inc_status = 'O' OR
       l_mast-inc_status = 'T'.
      l_date = l_mast-last_act_date + l_zim_rem-rem_days.
      IF l_date LE i_date.
        l_days_overdue = i_date - l_date.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to       = 'I'
            i_ass_emp      = l_mast-ima
            i_note_cat     = l_zim_rem-note_cat
            i_rule         = l_zim_rem-business_rule
            i_pernr        = i_pernr
            i_incident     = i_incident
            i_rem          = l_zim_rem
            i_update       = i_update
            i_days_overdue = l_days_overdue
            i_due_date     = l_date
            i_report       = i_report
          IMPORTING
            e_report       = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 03 - Category 99      - General Reminders
*      Business Rule 02 - No contact with IW for > 21 days
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '99'
           AND business_rule = '02'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_mast-inc_status = 'O' OR
       l_mast-inc_status = 'T'.
      IF l_mast-emp_contact IS NOT INITIAL.
        l_date = l_mast-emp_contact + l_zim_rem-rem_days.
      ELSE.
        IF l_mast-inc_status = 'T'.
          l_date = l_mast-reopened_date + l_zim_rem-rem_days.
        ELSE.
          l_date = l_mast-date_created + l_zim_rem-rem_days.
        ENDIF.
      ENDIF.
      IF l_date LE i_date.
        l_days_overdue = i_date - l_date.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to       = 'I'
            i_ass_emp      = l_mast-ima
            i_note_cat     = l_zim_rem-note_cat
            i_rule         = l_zim_rem-business_rule
            i_pernr        = i_pernr
            i_incident     = i_incident
            i_rem          = l_zim_rem
            i_update       = i_update
            i_days_overdue = l_days_overdue
            i_due_date     = l_date
            i_report       = i_report
          IMPORTING
            e_report       = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 04 - Category 18      - Medical Certificates/Certificates of Capacity
*      Business Rule 01 - The certificate of capacity has expired
*                         3 days after the expiry date
  IF l_mast-inc_status = 'O' OR
     l_mast-inc_status = 'T'.
    SELECT SINGLE * FROM zim_rem
           INTO l_zim_rem
           WHERE note_cat      = '18'
             AND business_rule = '01'.
    IF sy-subrc NE 0.
      l_zim_rem-inactive = 'X'.
    ENDIF.
    IF l_zim_rem-inactive IS INITIAL.

      IF l_zim_in_cert-date_to IS NOT INITIAL.
        l_days = l_zim_rem-rem_days.
        CALL FUNCTION 'BKK_ADD_WORKINGDAY'
          EXPORTING
            i_date      = l_zim_in_cert-date_to
            i_days      = l_days
            i_calendar1 = 'AU'
          IMPORTING
            e_date      = l_date
            e_return    = l_subrc.

        IF l_date LE i_date.
          l_days_overdue = i_date - l_date.
          CALL METHOD create_reminder
            EXPORTING
              i_ass_to       = 'I'
              i_ass_emp      = l_mast-ima
              i_note_cat     = l_zim_rem-note_cat
              i_rule         = l_zim_rem-business_rule
              i_pernr        = i_pernr
              i_incident     = i_incident
              i_rem          = l_zim_rem
              i_update       = i_update
              i_days_overdue = l_days_overdue
              i_due_date     = l_date
              i_report       = i_report
            IMPORTING
              e_report       = l_report.
          IF l_report IS NOT INITIAL.
            APPEND l_report TO tb_report.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 05 - Category 18      - Certificate of Capacity
*      Business Rule 02 - A Cert must be received within 14 days of
*                         the initial assessment
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '18'
           AND business_rule = '02'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF ( l_mast-inc_status = 'O' OR
         l_mast-inc_status = 'T' ) AND
       l_mast-init_ass_date IS NOT INITIAL.
      DESCRIBE TABLE tb_zim_in_cert LINES l_lines.
      l_days = i_date - l_mast-init_ass_date.
      IF l_days GE l_zim_rem-rem_days AND
         l_lines = 0.
        l_days_overdue = l_days - l_zim_rem-rem_days.
        l_date = l_mast-init_ass_date + l_zim_rem-rem_days.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to       = 'I'
            i_ass_emp      = l_mast-ima
            i_note_cat     = l_zim_rem-note_cat
            i_rule         = l_zim_rem-business_rule
            i_pernr        = i_pernr
            i_incident     = i_incident
            i_rem          = l_zim_rem
            i_update       = i_update
            i_days_overdue = l_days_overdue
            i_due_date     = l_date
            i_report       = i_report
          IMPORTING
            e_report       = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

*    - Category 18      - Certificate of Capacity
*      Business Rule 11 - Restricted Duties for 6 weeks
*                       – IMA to arrange a case conference
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '18'
           AND business_rule = '11'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL AND
     i_report IS INITIAL.                      " Not relevant for the report

    IF ( l_mast-inc_status = 'O' OR            "Incident is Open
         l_mast-inc_status = 'T'   ) AND
          "Incident is Re-opened
        ( l_zim_in_cert-status = 'SD'  OR
        "Med cert - Suitable duties
          l_zim_in_cert-status = 'C'   ).
      "Cert of Cap - Capacity
* check to determine if they have a second mc which is unfit
      SELECT SINGLE * FROM zim_in_cert
             INTO l_cert
             WHERE pernr     =  i_pernr
               AND date_from LE i_date
               AND date_to   GE i_date
               AND status    =  'U'.
      IF sy-subrc NE 0.
* check to determine if they have a second cc which is no capacity
        SELECT SINGLE * FROM zim_in_cap
               INTO l_cap
               WHERE pernr     =  i_pernr
                 AND date_from LE i_date
                 AND date_to   GE i_date
                 AND status    =  'N'.
        IF sy-subrc NE 0.

          l_days = i_date - l_mast-date_created.
          CLEAR l_doc_unique.
          l_doc_unique = 'O'.
*     if case is re-opened
          IF l_mast-inc_status = 'T'.
            l_days = i_date - l_mast-reopened_date.
            l_doc_unique = 'T'.
          ENDIF.

          IF l_days GE l_zim_rem-rem_days.
* only create a reminder if one has not already been created
            SELECT SINGLE * FROM zim_in_rem
                   INTO l_zim_in_rem
                   WHERE pernr         = i_pernr
                     AND incident      = i_incident
                     AND ass_to        = 'I'
                     AND ass_emp       = l_mast-ima
                     AND doc_unique    = l_doc_unique
                     AND note_cat      = l_zim_rem-note_cat
                     AND business_rule = l_zim_rem-business_rule
                     AND message_type  = 'B'.
            IF sy-subrc NE 0.
              l_days_overdue = l_days - l_zim_rem-rem_days.
              CALL METHOD create_reminder
                EXPORTING
                  i_ass_to       = 'I'
                  i_ass_emp      = l_mast-ima
                  i_note_cat     = l_zim_rem-note_cat
                  i_rule         = l_zim_rem-business_rule
                  i_pernr        = i_pernr
                  i_incident     = i_incident
                  i_rem          = l_zim_rem
                  i_update       = i_update
                  i_doc_unique   = l_doc_unique
                  i_days_overdue = l_days_overdue
                IMPORTING
                  e_report       = l_report.
              IF l_report IS NOT INITIAL.
                APPEND l_report TO tb_report.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 06 - Category 01      - Initial Assessment
*      Business Rule 02 - Info Consent Form received within 14 days of
*                         the initial assessment
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '01'
           AND business_rule = '02'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_mast-inc_status = 'O' AND
       l_mast-init_ass_date IS NOT INITIAL AND
       l_mast-info_consent IS INITIAL.
      l_days = i_date - l_mast-init_ass_date.
      IF l_days GE l_zim_rem-rem_days.
        l_days_overdue = l_days - l_zim_rem-rem_days.
        l_date = l_mast-init_ass_date + l_zim_rem-rem_days.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to       = 'I'
            i_ass_emp      = l_mast-ima
            i_note_cat     = l_zim_rem-note_cat
            i_rule         = l_zim_rem-business_rule
            i_pernr        = i_pernr
            i_incident     = i_incident
            i_rem          = l_zim_rem
            i_update       = i_update
            i_days_overdue = l_days_overdue
            i_due_date     = l_date
            i_report       = i_report
          IMPORTING
            e_report       = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 07 - Category 99      - General Reminders
*      Business Rule 03 - NTD/NTS must be contacted every month post 88
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '99'
           AND business_rule = '03'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF ( l_mast-inc_status = 'O'   OR
         l_mast-inc_status = 'T' ) AND
       l_mast-hod IS INITIAL   AND
       l_mast-inc_type NE 'N'.         "exclude NWR incidents
      IF l_mast-ntd_contact IS NOT INITIAL.
        l_date = l_mast-ntd_contact + l_zim_rem-rem_days.
        l_days = i_date - l_mast-ntd_contact.
      ELSE.
        IF l_mast-inc_status = 'T'.
          l_date = l_mast-reopened_date + l_zim_rem-rem_days.
          l_days = i_date - l_mast-reopened_date.
        ELSE.
          l_date = l_mast-date_created + l_zim_rem-rem_days.
          l_days = i_date - l_mast-date_created.
        ENDIF.
      ENDIF.
      IF l_days GE l_zim_rem-rem_days.
        l_days_overdue = l_days - l_zim_rem-rem_days.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to       = 'I'
            i_ass_emp      = l_mast-ima
            i_note_cat     = l_zim_rem-note_cat
            i_rule         = l_zim_rem-business_rule
            i_pernr        = i_pernr
            i_incident     = i_incident
            i_rem          = l_zim_rem
            i_update       = i_update
            i_days_overdue = l_days_overdue
            i_due_date     = l_date
            i_report       = i_report
          IMPORTING
            e_report       = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 07A - Category 99    - General Reminders
*     Business Rule 09 - NTD/NTS must be contacted every 2 months pre 88
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '99'
           AND business_rule = '09'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF ( l_mast-inc_status = 'O'   OR
         l_mast-inc_status = 'T' ) AND
       l_mast-hod        = 'X'.
      IF l_mast-ntd_contact IS NOT INITIAL.
        l_date = l_mast-ntd_contact + l_zim_rem-rem_days.
        l_days = i_date - l_mast-ntd_contact.
      ELSE.
        IF l_mast-inc_status = 'T'.
          l_date = l_mast-reopened_date + l_zim_rem-rem_days.
          l_days = i_date - l_mast-reopened_date.
        ELSE.
          l_date = l_mast-date_created + l_zim_rem-rem_days.
          l_days = i_date - l_mast-date_created.
        ENDIF.
      ENDIF.
      IF l_days GE l_zim_rem-rem_days.
        l_days_overdue = l_days - l_zim_rem-rem_days.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to       = 'I'
            i_ass_emp      = l_mast-ima
            i_note_cat     = l_zim_rem-note_cat
            i_rule         = l_zim_rem-business_rule
            i_pernr        = i_pernr
            i_incident     = i_incident
            i_rem          = l_zim_rem
            i_update       = i_update
            i_days_overdue = l_days_overdue
            i_due_date     = l_date
            i_report       = i_report
          IMPORTING
            e_report       = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.


* 08 - Category 99      - General Reminders
*      Business Rule 04 - A Case Conference must be held every 3 months
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '99'
           AND business_rule = '04'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF ( l_mast-inc_status = 'O'   OR
         l_mast-inc_status = 'T' ) AND
       l_mast-hod IS INITIAL.
      CLEAR l_zim_in_mtg.
      LOOP AT tb_zim_in_mtg INTO l_zim_in_mtg
           WHERE meet_type = 'C'.
        EXIT.
      ENDLOOP.

      IF l_zim_in_mtg-meet_date IS NOT INITIAL.
        l_date = l_zim_in_mtg-meet_date + l_zim_rem-rem_days.
        l_days = i_date - l_zim_in_mtg-meet_date.
      ELSE.
        IF l_mast-inc_status = 'T'.
          l_date = l_mast-reopened_date + l_zim_rem-rem_days.
          l_days = i_date - l_mast-reopened_date.
        ELSE.
          l_date = l_mast-date_created + l_zim_rem-rem_days.
          l_days = i_date - l_mast-date_created.
        ENDIF.
      ENDIF.
      IF l_days GE l_zim_rem-rem_days.
        l_days_overdue = l_days - l_zim_rem-rem_days.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to       = 'I'
            i_ass_emp      = l_mast-ima
            i_note_cat     = l_zim_rem-note_cat
            i_rule         = l_zim_rem-business_rule
            i_pernr        = i_pernr
            i_incident     = i_incident
            i_rem          = l_zim_rem
            i_update       = i_update
            i_days_overdue = l_days_overdue
            i_due_date     = l_date
            i_report       = i_report
          IMPORTING
            e_report       = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

* 09 - Category 99      - General Reminders
*      Business Rule 05 - An IMP must be held every 60 days
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '99'
           AND business_rule = '05'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF ( l_mast-inc_status = 'O'   OR
         l_mast-inc_status = 'T' ).
      CLEAR l_zim_in_mtg.
      LOOP AT tb_zim_in_mtg INTO l_zim_in_mtg
           WHERE meet_type = 'I'.
        EXIT.
      ENDLOOP.

      IF l_zim_in_mtg-meet_date IS NOT INITIAL.
        l_date = l_zim_in_mtg-meet_date + l_zim_rem-rem_days.
        l_days = i_date - l_zim_in_mtg-meet_date.
      ELSE.
        IF l_mast-inc_status = 'T'.
          l_date = l_mast-reopened_date + l_zim_rem-rem_days.
          l_days = i_date - l_mast-reopened_date.
        ELSE.
          l_date = l_mast-date_created + l_zim_rem-rem_days.
          l_days = i_date - l_mast-date_created.
        ENDIF.
      ENDIF.
      IF l_days GE l_zim_rem-rem_days.
        l_days_overdue = l_days - l_zim_rem-rem_days.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to       = 'I'
            i_ass_emp      = l_mast-ima
            i_note_cat     = l_zim_rem-note_cat
            i_rule         = l_zim_rem-business_rule
            i_pernr        = i_pernr
            i_incident     = i_incident
            i_rem          = l_zim_rem
            i_update       = i_update
            i_days_overdue = l_days_overdue
            i_due_date     = l_date
            i_report       = i_report
          IMPORTING
            e_report       = l_report.
        IF l_report IS NOT INITIAL.
          APPEND l_report TO tb_report.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.


* 09A - Category 99      - General Reminders
*       Business Rule 12 - Agenda sent for case conference meeting 5 days before meeting date
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '99'
           AND business_rule = '12'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF ( l_mast-inc_status = 'O'   OR
         l_mast-inc_status = 'T' ).
      CLEAR l_zim_in_mtg.
      LOOP AT tb_zim_in_mtg INTO l_zim_in_mtg
           WHERE meet_type = 'C'.
        EXIT.
      ENDLOOP.

      IF l_zim_in_mtg-meet_date IS NOT INITIAL AND
         l_zim_in_mtg-meet_date GT i_date      AND
         l_zim_in_mtg-agendax IS INITIAL.
        l_days = l_zim_rem-rem_days * -1.
        CALL FUNCTION 'BKK_ADD_WORKINGDAY'
          EXPORTING
            i_date      = l_zim_in_mtg-meet_date
            i_days      = l_days
            i_calendar1 = 'AU'
          IMPORTING
            e_date      = l_date
            e_return    = l_subrc.

        IF l_date LE i_date.
          l_days_overdue = i_date - l_date.
          CALL METHOD create_reminder
            EXPORTING
              i_ass_to       = 'I'
              i_ass_emp      = l_mast-ima
              i_note_cat     = l_zim_rem-note_cat
              i_rule         = l_zim_rem-business_rule
              i_pernr        = i_pernr
              i_incident     = i_incident
              i_rem          = l_zim_rem
              i_update       = i_update
              i_days_overdue = l_days_overdue
              i_due_date     = l_date
              i_report       = i_report
            IMPORTING
              e_report       = l_report.
          IF l_report IS NOT INITIAL.
            APPEND l_report TO tb_report.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

