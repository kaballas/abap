* 08 - Category 20      - Deployment Unit
*      Business Rule 27 - Emp Email for Prop Pos not sent
*      14 days of the Placement type
  SELECT SINGLE * FROM zim_rem
         INTO l_zim_rem
         WHERE note_cat      = '20'
           AND business_rule = '27'.
  IF sy-subrc NE 0.
    l_zim_rem-inactive = 'X'.
  ENDIF.
  IF l_zim_rem-inactive IS INITIAL.

    IF l_zim_in_deploy-date_closed IS INITIAL AND
       l_zim_in_deploy-prop_pos_sent_dt IS INITIAL AND
       l_zim_in_deploy-place_type_dt IS NOT INITIAL.

      l_days = i_date - l_zim_in_deploy-place_type_dt.

      IF l_days GE l_zim_rem-rem_days.
        l_days_overdue = l_days - l_zim_rem-rem_days.
        l_date = l_zim_in_deploy-place_type_dt + l_zim_rem-rem_days.
        CALL METHOD create_reminder
          EXPORTING
            i_ass_to       = 'U'
            i_ass_emp      = l_zim_in_deploy-case_officer
            i_note_cat     = l_zim_rem-note_cat
            i_rule         = l_zim_rem-business_rule
            i_pernr        = i_pernr
