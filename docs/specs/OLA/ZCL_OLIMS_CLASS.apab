* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>OBJECT_DESC
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_DATE                         TYPE        DATUM
* | [--->] I_OBJID                        TYPE        ANY
* | [--->] I_OTYPE                        TYPE        OTYPE
* | [--->] I_PLVAR                        TYPE        PLVAR (default ='01')
* | [<---] E_STEXT                        TYPE        STEXT
* | [<---] E_SHORT                        TYPE        SHORT_D
* +--------------------------------------------------------------------------------------</SIGNATURE>
method OBJECT_DESC.

  data :  l_objid      type hrealo-realo,
          l_name       type p1000-stext,
          l_short      type p1000-short,
          l_begda      type d,
          l_endda      type d.

  l_objid = i_objid.

  if i_date is not initial.
    l_begda = i_date.
    l_endda = i_date.
  else.
    l_begda = '0000101'.
    l_endda = sy-datum.
  endif.

  call function 'RH_READ_OBJECT'
    exporting
      plvar           = i_plvar
      otype           = i_otype
      realo           = l_objid
      begda           = l_begda
      endda           = l_endda
      check_stru_auth = ' '
    importing
      stext           = l_name
      short           = l_short
    exceptions
      not_found       = 1
      others          = 2.
  if sy-subrc <> 0.
    clear l_name.
  endif.

  e_stext = l_name.
  e_short = l_short.


endmethod.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>PREPARE_CORRESPONDENCE
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_PERNR                        TYPE        PERSNO
* | [--->] I_INCIDENT                     TYPE        ZHR_INC_IDENTNR
* | [--->] I_CATEGORY                     TYPE        ZIM_LETTER_CATEGORY
* | [<---] E_ERROR                        TYPE        CHAR1
* | [<---] E_MESSAGE                      TYPE        STRINGVAL
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD prepare_correspondence.

  DATA : l_ltr_deft           TYPE zim_ltr_deft,
         l_ltr_def            TYPE zim_ltr_def,
         tb_ltr_def           TYPE STANDARD TABLE OF zim_ltr_def,
         l_pernr              TYPE persno,
         l_corr_detail        TYPE zim_corr_detail,
         tb_corr_detail       TYPE zim_corr_detail_t,
         l_email_detail       TYPE zim_email_detail,
         tb_email_detail      TYPE zim_email_detail_t,
         tb_zim_in_doc        TYPE STANDARD TABLE OF zim_in_doc,
         l_zim_in_doc         TYPE zim_in_doc,
         l_desc               TYPE val_text,
         l_value              TYPE domvalue_l,
         tbl_users            TYPE zgen_users_t,
         l_users              TYPE zgen_users,
         l_stxh               TYPE stxh,
         l_ltr_system         TYPE char2.

  CLEAR : e_error, e_message.

  SELECT * FROM zim_ltr_def
    INTO TABLE tb_ltr_def
    WHERE ltr_category = i_category.

  LOOP AT tb_ltr_def INTO l_ltr_def.
    CLEAR l_corr_detail.
    l_corr_detail-pernr          = i_pernr.
    l_corr_detail-incident       = i_incident.
    l_corr_detail-dist_meth      = 'E'.
    l_corr_detail-ltr_category   = l_ltr_def-ltr_category.
    l_corr_detail-corr_code      = l_ltr_def-corr_code.
    l_corr_detail-email_body     = l_ltr_def-email_body.

    SELECT SINGLE * FROM stxh
           INTO l_stxh
           WHERE tdobject = 'ZPOLICE'
             AND tdname   = l_ltr_def-email_body.
    IF sy-subrc = 0.
      IF l_stxh-tdid = 'ZIM2'.
        l_ltr_system = 'I1'.
      ELSE.
        l_ltr_system = 'I2'.
      ENDIF.
    ENDIF.

    CALL METHOD read_email_body(
      EXPORTING
        i_pernr      = i_pernr
        i_incident   = i_incident
        i_email_body = l_ltr_def-email_body
        i_ltr_system = l_ltr_system
      IMPORTING
        e_text       = l_corr_detail-body_str ).

    IF l_ltr_def-def_emp = 'X'.
      l_corr_detail-user_cat  = 'E'.
      l_corr_detail-user_code = i_pernr.
      CALL METHOD get_emp_email(
        EXPORTING
          i_pernr = l_corr_detail-user_code
        IMPORTING
          e_email = l_corr_detail-email
          e_name  = l_corr_detail-user_name ).
      APPEND l_corr_detail TO tb_corr_detail.
    ENDIF.

    IF l_ltr_def-def_emp_home = 'X'.
      l_corr_detail-user_cat  = 'E'.
      l_corr_detail-user_code = i_pernr.
      CALL METHOD get_emp_home_email(
        EXPORTING
          i_pernr    = l_corr_detail-user_code
          i_incident = i_incident
        IMPORTING
          e_email    = l_corr_detail-email
          e_name     = l_corr_detail-user_name ).
      APPEND l_corr_detail TO tb_corr_detail.
    ENDIF.

  ENDLOOP.

  SORT tb_corr_detail BY user_cat.
  LOOP AT tb_corr_detail INTO l_corr_detail.
    IF l_corr_detail-user_cat NE l_value.
      l_value = l_corr_detail-user_cat.
      l_desc  = get_domain_desc( i_domain = 'ZIM_USER_CATEGORY'
                                 i_value  = l_value ).
    ENDIF.
    l_corr_detail-user_desc  = l_desc.

    MODIFY tb_corr_detail FROM l_corr_detail.
  ENDLOOP.

  CALL METHOD send_correspondence(
    EXPORTING
      tb_corr_detail = tb_corr_detail
    IMPORTING
      e_error        = e_error
      e_message      = e_message ).


ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>READ_EMAIL_BODY
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_EMAIL_BODY                   TYPE        TDOBNAME
* | [--->] I_PERNR                        TYPE        PERSNO
* | [--->] I_INCIDENT                     TYPE        ZHR_INC_IDENTNR(optional)
* | [--->] I_LTR_SYSTEM                   TYPE        CHAR2(optional)
* | [<---] E_TEXT                         TYPE        STRING
* | [<---] E_ERROR                        TYPE        CHAR1
* | [<---] E_ERROR_MSG                    TYPE        TEXT80
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD read_email_body.

  DATA : l_thead                 TYPE thead,
         tbl_tline               TYPE tlinetab,
         tbl_string              TYPE string_table,
         rec_string              TYPE string,
         l_zimltrvar             TYPE zimltrvar,
         l_zimltrvar1            TYPE zimltrvar1,
         l_zimltrvar2            TYPE zimltrvar2,
         l_in_mast               TYPE zim_in_mast,
         t_email_body            TYPE STANDARD TABLE OF tline.

  CLEAR e_text.

  SELECT SINGLE * FROM zim_in_mast
         INTO l_in_mast
         WHERE pernr    = i_pernr
           AND incident = i_incident.
  IF sy-subrc NE 0.
    CLEAR l_in_mast.
  ENDIF.

  CALL FUNCTION 'Z_FILL_WORD_VARIABLES'
    EXPORTING
      i_zim_in_mast = l_in_mast
    IMPORTING
      e_ltrvar      = l_zimltrvar
    TABLES
      t_email_body  = t_email_body.


  MOVE-CORRESPONDING l_zimltrvar      TO l_zimltrvar1.
  MOVE-CORRESPONDING l_zimltrvar      TO l_zimltrvar2.

  IF i_ltr_system = 'I2'.
    CALL FUNCTION 'Z_PREVIEW_BODY_WEB_STRING'
      EXPORTING
        ltr_system    = 'I2'
        ltr_tdname    = i_email_body
        ltr_variables = l_zimltrvar2
      IMPORTING
        e_error       = e_error
        e_error_msg   = e_error_msg
        e_stringtable = tbl_string.
  ELSE.
    CALL FUNCTION 'Z_PREVIEW_BODY_WEB_STRING'
      EXPORTING
        ltr_system    = 'I1'
        ltr_tdname    = i_email_body
        ltr_variables = l_zimltrvar1
      IMPORTING
        e_error       = e_error
        e_error_msg   = e_error_msg
        e_stringtable = tbl_string.
  ENDIF.


  LOOP AT tbl_string INTO rec_string.
    CONCATENATE e_text rec_string
                cl_abap_char_utilities=>newline
                INTO e_text.
  ENDLOOP.



ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>SAVE_IN_PAWE_LOST
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_IN_PAWE_LOST                 TYPE        ZIM_IN_PAWE_LOST
* | [--->] I_ACTION                       TYPE        CHAR1
* | [<---] E_ERROR                        TYPE        CHAR1
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD save_in_pawe_lost.

  clear e_error.
  IF i_action = 'I'.
    INSERT zim_in_pawe_lost FROM i_in_pawe_lost.
  ELSEIF i_action = 'U'.
    UPDATE zim_in_pawe_lost FROM i_in_pawe_lost.
  ENDIF.

  IF sy-subrc NE 0.
    e_error = 'X'.
    ROLLBACK WORK.
    RETURN.
  ENDIF.

  CALL METHOD save_in_pawe_lost_log
    EXPORTING
      i_in_pawe_lost = i_in_pawe_lost
      i_action       = i_action
    IMPORTING
      e_error        = e_error.


ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>SAVE_IN_PAWE_LOST_LOG
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_IN_PAWE_LOST                 TYPE        ZIM_IN_PAWE_LOST
* | [--->] I_ACTION                       TYPE        CHAR1
* | [<---] E_ERROR                        TYPE        CHAR1
* +--------------------------------------------------------------------------------------</SIGNATURE>
method SAVE_IN_PAWE_LOST_LOG.


  data : rec_zim_in_pawe_lost_log     type zim_in_pawe_losl.

  clear rec_zim_in_pawe_lost_log.
  move-corresponding i_in_pawe_lost to rec_zim_in_pawe_lost_log.
  rec_zim_in_pawe_lost_log-date_processed = sy-datum.
  rec_zim_in_pawe_lost_log-time_processed = sy-uzeit.
  rec_zim_in_pawe_lost_log-code_processed = i_action.
  rec_zim_in_pawe_lost_log-user_processed = sy-uname.
  insert zim_in_pawe_losl from rec_zim_in_pawe_lost_log.
  if sy-subrc ne 0.
*   rollback work.
    e_error = 'X'.
  endif.


endmethod.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>SAVE_IN_REM_LOG
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_IN_REM                       TYPE        ZIM_IN_REM
* | [--->] I_ACTION                       TYPE        CHAR1
* | [<---] E_ERROR                        TYPE        CHAR1
* +--------------------------------------------------------------------------------------</SIGNATURE>
method SAVE_IN_REM_LOG.


  data : rec_zim_in_rem_log     type zim_in_rem_log.

  clear rec_zim_in_rem_log.
  move-corresponding i_in_rem to rec_zim_in_rem_log.
  rec_zim_in_rem_log-date_processed = sy-datum.
  rec_zim_in_rem_log-time_processed = sy-uzeit.
  rec_zim_in_rem_log-code_processed = i_action.
  rec_zim_in_rem_log-user_processed = sy-uname.
  insert zim_in_rem_log from rec_zim_in_rem_log.
  if sy-subrc ne 0.
*   rollback work.
    e_error = 'X'.
  endif.


endmethod.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>SEND_CORRESPONDENCE
* +-------------------------------------------------------------------------------------------------+
* | [--->] TB_CORR_DETAIL                 TYPE        ZIM_CORR_DETAIL_T
* | [--->] I_RAW                          TYPE        CHAR1(optional)
* | [<---] E_ERROR                        TYPE        CHAR1
* | [<---] E_MESSAGE                      TYPE        STRINGVAL
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD send_correspondence.


  DATA : l_ltr_deft           TYPE zim_ltr_deft,
         l_ltr_def            TYPE zim_ltr_def,
         tb_ltr_def           TYPE STANDARD TABLE OF zim_ltr_def,
         l_pernr              TYPE persno,
         l_corr_detail        TYPE zim_corr_detail,
         tb_corr_detail2      TYPE zim_corr_detail_t,
         l_email_detail       TYPE zim_email_detail,
         tb_email_detail      TYPE zim_email_detail_t,
         l_desc               TYPE val_text,
         l_value              TYPE domvalue_l,
         tbl_users            TYPE zgen_users_t,
         l_users              TYPE zgen_users.

  CLEAR : e_error, e_message.

  tb_corr_detail2[] = tb_corr_detail[].

  LOOP AT tb_corr_detail2 INTO l_corr_detail.
    MOVE-CORRESPONDING l_corr_detail TO l_email_detail.
    APPEND l_email_detail TO tb_email_detail.
  ENDLOOP.

  CALL METHOD send_email(
    EXPORTING
      t_email_detail = tb_email_detail
      i_raw          = i_raw
    IMPORTING
      e_error        = e_error ).
  IF e_error IS NOT INITIAL.
    e_message = 'Error in Sending the Email'.
    RETURN.
  ENDIF.

* Update the tables with the outgoing correspondence
  DATA : l_doc_seq_no         TYPE zim_doc_seq_no,
         l_out_seq_no         TYPE zim_seq_no,
         l_rec_seq_no         TYPE zim_seq_no,
         l_body_doc_id        TYPE saeardoid,
         l_in_doc             TYPE zim_in_doc,
         l_in_doc_rec         TYPE zim_in_doc_rec,
         l_new                TYPE c,
         l_new_user           TYPE c,
         l_object_id          TYPE saeobjid,
         l_ar_object          TYPE saeobjart,
         l_arch_object        TYPE saeardoid,
         l_arch_object2       TYPE saeardoid,
         l_filename_out       TYPE string,
         ls_return            TYPE bapiret2,
         l_size               TYPE i,
         tbl_upload_bin       TYPE STANDARD TABLE OF tbl1024,
         l_error              TYPE c,
         l_message            TYPE string,
         l_filename           TYPE string,
         l_text_key           TYPE tdobname,
         tb_note              TYPE STANDARD TABLE OF zim_note,
         l_note               TYPE zim_note,
         l_code(20)           TYPE c,
         l_text1              TYPE text132,
         l_text2              TYPE text132,
         l_text3(70)          TYPE c.


  LOOP AT tb_corr_detail2 INTO l_corr_detail.
    AT NEW email_body.
      l_new = 'X'.
      CLEAR l_rec_seq_no.
    ENDAT.

    IF l_new IS NOT INITIAL.
      CLEAR l_new.

      SELECT MAX( doc_seq_no )
             INTO l_doc_seq_no
             FROM zim_in_doc
             WHERE pernr    = l_corr_detail-pernr
               AND incident = l_corr_detail-incident.
      IF sy-subrc NE 0.
        CLEAR l_doc_seq_no.
      ENDIF.

* Create the Correspondence record
      CLEAR l_in_doc.
      ADD 1 TO l_doc_seq_no.
      l_in_doc-pernr          = l_corr_detail-pernr.
      l_in_doc-incident       = l_corr_detail-incident.
      l_in_doc-doc_seq_no     = l_doc_seq_no.
      l_in_doc-ltr_category   = l_corr_detail-ltr_category.
      l_in_doc-corr_code      = l_corr_detail-corr_code.
      l_in_doc-date_processed = sy-datum.

      CONCATENATE l_corr_detail-email_body '.TXT'
                  INTO l_filename.
      CONCATENATE l_corr_detail-pernr l_corr_detail-incident 'A'
                  INTO l_object_id.
      CALL FUNCTION 'Z_TRIM_SAVE_DOCUMENT'
        EXPORTING
          i_ar_object   = 'ZOLIMS'
          i_filename    = l_filename
          i_format      = 'A'
          i_object_id   = l_object_id
          i_upload_asc  = l_corr_detail-body_str
          i_size        = l_size
        IMPORTING
          e_arch_object = l_arch_object
          e_filename    = l_filename_out
          e_error       = l_error
          e_message     = l_message.

      IF l_error IS NOT INITIAL.
        MESSAGE e999(zz) WITH l_message.
        ROLLBACK WORK.
        EXIT.
      ENDIF.

      l_in_doc-body_doc_id = l_arch_object.

      INSERT zim_in_doc FROM l_in_doc.
      IF sy-subrc NE 0.
        e_error = 'X'.
        e_message = 'Error in updating ZIM_IN_DOC'.
        ROLLBACK WORK.
        RETURN.
      ENDIF.

      CALL METHOD trim_meta_data
        EXPORTING
          i_arch_object = l_arch_object
          i_pernr       = l_corr_detail-pernr
          i_incident    = l_corr_detail-incident
          i_category    = l_corr_detail-ltr_category
          i_filename    = l_filename.

    ENDIF.

* Create the Receiver details
    CLEAR l_in_doc_rec.
    l_in_doc_rec-pernr          = l_corr_detail-pernr.
    l_in_doc_rec-incident       = l_corr_detail-incident.
    l_in_doc_rec-doc_seq_no     = l_doc_seq_no.
    l_in_doc_rec-user_cat       = l_corr_detail-user_cat.
    l_in_doc_rec-user_code      = l_corr_detail-user_code.
    l_in_doc_rec-user_name      = l_corr_detail-user_name.
    l_in_doc_rec-date_processed = sy-datum.
    l_in_doc_rec-time_processed = sy-uzeit.
    l_in_doc_rec-dist_meth      = l_corr_detail-dist_meth.
    l_in_doc_rec-email          = l_corr_detail-email.
    ADD 1 TO l_rec_seq_no.
    l_in_doc_rec-rec_seq_no     = l_rec_seq_no.
    INSERT zim_in_doc_rec FROM l_in_doc_rec.
    IF sy-subrc NE 0.
      e_error = 'X'.
      e_message = 'Error in updating ZIM_IN_DOC_REC'.
      ROLLBACK WORK.
      RETURN.
    ENDIF.

    IF l_corr_detail-user_cat = 'O'.
      CONCATENATE 'sent to -'
                  l_corr_detail-user_name
                  INTO l_text3 SEPARATED BY ' '.
    ELSE.
      CONCATENATE 'sent to the'
                  l_corr_detail-user_desc
                  '-' l_corr_detail-user_name
                  INTO l_text3 SEPARATED BY ' '.
    ENDIF.

    CONCATENATE 'An Email has been' l_text3
                 INTO l_text1 SEPARATED BY ' '.
    CONCATENATE 'containing the' l_filename
                'correspondence'
                 INTO l_text2 SEPARATED BY ' '.

    SELECT * FROM zim_note
           INTO TABLE tb_note
           WHERE ltr_category = l_corr_detail-ltr_category.
    LOOP AT tb_note INTO l_note.
      CASE l_note-note_upd_category.
        WHEN 'I'.
          l_code = 'CASE'.
        WHEN 'C'.
          l_code = 'LEGAL'.
        WHEN 'D'.
          l_code = 'DEPLOYMENT'.
        WHEN 'P'.
          l_code = 'IP'.
        WHEN 'S'.
          l_code = 'PRE88'.
        WHEN 'W'.
          l_code = 'WC'.
      ENDCASE.
      CONCATENATE l_corr_detail-pernr l_corr_detail-incident
                  l_code
                  INTO l_text_key.
      CALL METHOD update_notes(
        EXPORTING
          i_text_key = l_text_key
          i_text1    = l_text1
          i_text2    = l_text2 ).
    ENDLOOP.


  ENDLOOP.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>SEND_EMAIL
* +-------------------------------------------------------------------------------------------------+
* | [--->] T_EMAIL_DETAIL                 TYPE        ZIM_EMAIL_DETAIL_T
* | [--->] I_RAW                          TYPE        CHAR1(optional)
* | [<---] E_ERROR                        TYPE        CHAR1
* +--------------------------------------------------------------------------------------</SIGNATURE>
method SEND_EMAIL.


  type-pools: ixml.

  class cl_bcs definition load.

  data : l_email_detail      type zim_email_detail,
         w_dob               type char1,
         t_att_content_hex   type solix_tab,
         lo_send_request     type ref to cl_bcs value is initial,
         lt_message_body     type bcsy_text value is initial,
         lo_document         type ref to cl_document_bcs value is initial,
         lx_document_bcs     type ref to cx_document_bcs value is initial,
         lo_sender           type ref to if_sender_bcs value is initial,
         l_send              type adr6-smtp_addr value 'SAPADMIN',
         lo_recipient        type ref to if_recipient_bcs value is initial,
         l_subject           type so_obj_des,
         l_att_subject       type sood-objdes,
         l_first             type c,
         l_first_att         type c,
         l_doc_size          type i,
         l_att_size          type sood-objlen,
         l_type              type so_obj_tp.

  if i_raw is initial.
    l_type = 'HTM'.
  else.
    l_type = 'RAW'.
  endif.

  loop at t_email_detail into l_email_detail.

    at new email_body.
      lo_send_request = cl_bcs=>create_persistent( ).
      l_first = 'X'.
    endat.

    at new email_att.
      l_first_att = 'X'.
    endat.

    if l_first = 'X'.
      refresh lt_message_body.
      if i_raw is initial.
* Required when using HTM
        call method convert_string_to_table_html(
          exporting
            i_string    = l_email_detail-body_str
            i_line_size = 255
            i_append    = ' '
          importing
            e_table     = lt_message_body ).
      else.
* Required when using RAW
        call method convert_string_to_table(
          exporting
            i_string    = l_email_detail-body_str
            i_line_size = 255
            i_append    = ' '
          importing
            e_table     = lt_message_body ).
      endif.

      if l_email_detail-dist_meth = 'E'.
        l_subject = 'Injury Management'.
        concatenate l_subject '[Sensitive Personal]'
                    into l_subject separated by ' '.
      endif.

      if syst-sysid ne 'DB1'.
        concatenate '*** TEST EMAIL ***' l_subject
                    into l_subject
                    separated by ' '.
      endif.

      try.

* NOTE - The best format for sending emails is RAW.
* If the email is to have an embedded URL and you want to hide
* the URL using the HTML href command, the type MUST be HTM,
* otherwise Lotus Notes will not recognise the HTML command.
* When the type HTM is used, the format of the text needs to
* be changed.

          lo_document = cl_document_bcs=>create_document(
                        i_type = l_type
                        i_text = lt_message_body
                        i_subject = l_subject ).

          lo_send_request->set_document( lo_document ).
          lo_sender = cl_sapuser_bcs=>create( 'SAPADMIN' ).
          lo_send_request->set_sender(
                  exporting
                     i_sender = lo_sender ).

          lo_recipient =
           cl_cam_address_bcs=>create_internet_address(
                               l_email_detail-email ).

          lo_send_request->add_recipient(
             exporting
               i_recipient = lo_recipient ).

        catch cx_send_req_bcs
              cx_address_bcs.
          e_error = 'X'.
          return.
      endtry.

    endif.

    clear l_first.

    if l_first_att = 'X'.
      if l_email_detail-email_att is not initial.
        try.
            call function 'SCMS_XSTRING_TO_BINARY'
              exporting
                buffer        = l_email_detail-att_str
              importing
                output_length = l_doc_size
              tables
                binary_tab    = t_att_content_hex.

            l_att_subject = l_email_detail-email_att.
            l_att_size    = l_doc_size.
            lo_document->add_attachment(
              exporting
              i_attachment_type    = l_email_detail-att_type(3)
              i_attachment_subject = l_att_subject
              i_attachment_size    = l_att_size
              i_att_content_hex    = t_att_content_hex ).

          catch cx_document_bcs into lx_document_bcs.
        endtry.
      endif.
    endif.

    if l_email_detail-add_file is not initial.
      try.
          call function 'SCMS_XSTRING_TO_BINARY'
            exporting
              buffer        = l_email_detail-add_str
            importing
              output_length = l_doc_size
            tables
              binary_tab    = t_att_content_hex.

          l_att_subject = l_email_detail-add_file.
          l_att_size    = l_doc_size.
          lo_document->add_attachment(
            exporting
            i_attachment_type    = l_email_detail-att_type(3)
            i_attachment_subject = l_att_subject
            i_attachment_size    = l_att_size
            i_att_content_hex    = t_att_content_hex ).

        catch cx_document_bcs into lx_document_bcs.
      endtry.
    endif.

    clear l_first_att.

    at end of email_body.

      try.

          lo_send_request->send(
             exporting
               i_with_error_screen = 'X' ).

        catch cx_send_req_bcs
              cx_address_bcs.
          e_error = 'X'.
          return.
      endtry.

      commit work.
    endat.

  endloop.


endmethod.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_OLIMS_CLASS=>TRIM_META_DATA
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_ARCH_OBJECT                  TYPE        SAEARDOID
* | [--->] I_PERNR                        TYPE        PERSNO
* | [--->] I_INCIDENT                     TYPE        ZHR_INC_IDENTNR
* | [--->] I_CATEGORY                     TYPE        ZIM_LETTER_CATEGORY
* | [--->] I_FILENAME                     TYPE        ANY
* +--------------------------------------------------------------------------------------</SIGNATURE>
method TRIM_META_DATA.

 data : l_desc                type val_text,
        l_value               type domvalue_l,
        l_pa0002              type pa0002,
        l_name(80)            type c,
        l_date10(10)          type c,
        l_date10b(10)         type c.

  select single * from pa0002
         into l_pa0002
         where pernr = i_pernr
           and begda le sy-datum
           and endda ge sy-datum.
  if sy-subrc ne 0.
    clear l_pa0002.
  endif.

    l_value = i_category.
    l_desc  = get_domain_desc( i_domain = 'ZIM_LETTER_CATEGORY'
                               i_value  = l_value ).


  translate l_pa0002-nachn to upper case.
  concatenate l_pa0002-nachn l_pa0002-vorna into
              l_name separated by ' '.
  write sy-datum to l_date10 dd/mm/yyyy.
  translate l_date10 using './'.
  write l_pa0002-gbdat to l_date10b dd/mm/yyyy.
  translate l_date10b using './'.
  call function 'Z_TRIM_INS_METADATA_GROUP'
    exporting
      i_archiv_id  = 'Z1'
      i_arc_doc_id = i_arch_object
      i_code01     = 'Document Date'
      i_value01    = l_date10
      i_code02     = 'Employee Name (FAMILY NAME, Given Name)'
      i_value02    = l_name
      i_code03     = 'Incident Number'
      i_value03    = i_incident
      i_code04     = 'Serial / Registered No'
      i_value04    = i_pernr
      i_code05     = 'Document Category'
      i_value05    = l_desc
      i_code06     = 'Document Name'
      i_value06    = i_filename
      i_code07     = 'Date of Birth'
      i_value07    = l_date10b
      i_code08     = 'Date Action Completed'
      i_value08    = ' '.

endmethod.


